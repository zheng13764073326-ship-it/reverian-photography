{
  "name": "reverian-photography",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @reverian/web",
    "studio": "npm run dev -w @reverian/studio",
    "build": "node scripts/build-site.mjs",
    "build:production": "node scripts/build-site.mjs --production",
    "preview": "npm run preview -w @reverian/web",
    "check": "npm run check -w @reverian/web && npm run check -w @reverian/studio && tsc -p functions/tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
