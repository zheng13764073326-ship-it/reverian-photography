---
import '../styles/critique.css';
import {CRITIQUE_DIMENSIONS,CRITIQUE_LABELS} from '../lib/critique-contract';
import QRCode from 'qrcode';
const modules=QRCode.create('https://reverian.cc/',{errorCorrectionLevel:'M'}).modules;
const qr={size:modules.size,bits:Array.from(modules.data).join('')};
---
<div class="darkroom" data-darkroom data-state="empty" data-has-photo="false" data-critique-qr={JSON.stringify(qr)} data-critique-example-src="/images/ai-creations/rainy-harbor-original.webp">
  <h2 id="lab-section-critique" class="lab-sr-only">上传照片与分析报告</h2>
  <div class="darkroom-tone" role="group" aria-label="评片语气">
    <span>评片语气</span><div class="darkroom-tone-switch"><button type="button" data-critique-tone="gentle" aria-pressed="true">温和客观</button><button type="button" data-critique-tone="direct" aria-pressed="false">直白锐评</button></div>
  </div>
  <input class="lab-sr-only" type="file" accept="image/jpeg,image/png,image/webp" data-critique-file tabindex="-1" aria-label="选择待分析照片"/>
  <div class="darkroom-workspace">
    <section class="darkroom-contact" aria-label="上传与照片预览">
      <button type="button" class="darkroom-drop" data-critique-drop aria-label="拖入或点击上传照片，支持 JPG、PNG、WebP">
        <svg width="42" height="42" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M18 9H9a3 3 0 0 0-3 3v26a3 3 0 0 0 3 3h30a3 3 0 0 0 3-3V25M27 10l7-7 7 7M34 3v22M6 32l11-12 16 21"/><circle cx="21" cy="14" r="2"/></svg>
        <strong>拖入或点击上传照片</strong><span>支持 JPG / PNG / WEBP，单张实时分析</span>
      </button>
      <div class="darkroom-upload-extras" data-critique-upload-extras>
        <button type="button" class="darkroom-example" data-critique-example>没有合适照片？用示例图试一下</button>
        <ul class="darkroom-dimension-hints" aria-label="分析维度"><li>构图重心</li><li>光影明暗</li><li>色彩搭配</li><li>情绪与建议</li></ul>
      </div>
      <figure class="darkroom-preview" data-critique-preview hidden>
        <div class="darkroom-image"><img data-critique-image width="1024" height="683" loading="lazy" alt="待分析照片的本地预览" decoding="async"/><span class="darkroom-scan" aria-hidden="true"></span></div>
        <figcaption data-critique-filename></figcaption>
      </figure>
      <div class="darkroom-photo-actions" data-critique-photo-actions hidden>
        <button type="button" class="darkroom-button darkroom-secondary" data-critique-reset><span aria-hidden="true">↺</span> 重新上传</button>
        <button type="button" class="darkroom-button" data-critique-copy hidden>复制评片结果</button>
        <button type="button" class="darkroom-export-link" data-critique-export aria-haspopup="dialog" aria-controls="critique-share-preview" hidden>↓ 导出报告图片</button>
      </div>
      <p class="darkroom-copy-status" data-critique-copy-status role="status" aria-live="polite" hidden></p>
    </section>
    <section class="darkroom-sheet" aria-label="照片分析报告" data-critique-sheet aria-busy="false" hidden>
      <div class="darkroom-developing" data-critique-developing hidden><div class="darkroom-progress-mark" aria-hidden="true"></div><h3 data-critique-progress>本地压缩中…</h3><p>分析通常需要片刻，请保持页面打开。</p></div>
      <article class="darkroom-report" data-critique-report hidden aria-labelledby="critique-report-title" tabindex="-1">
        <header><p id="critique-report-title" data-critique-mode>AI 评片 · 温和客观</p><span class="darkroom-reference-score" title="四项评分的算术平均值，保留一位小数">综合评分 <b data-critique-score>—</b><small>/ 10 · 四项均值</small></span></header>
        <p class="darkroom-verdict" data-critique-verdict></p>
        <div class="darkroom-dimensions">{CRITIQUE_DIMENSIONS.map(key=><section class="darkroom-dimension"><h3>{CRITIQUE_LABELS[key]}<span><b data-dimension-score={key}>—</b><small>/ 10</small></span></h3><div class="darkroom-rule" role="meter" aria-label={CRITIQUE_LABELS[key]} aria-valuemin="0" aria-valuemax="10" data-dimension-bar={key}><i></i></div><p data-dimension-analysis={key}></p></section>)}</div>
        <section class="darkroom-notes"><h3>调整建议</h3><ol data-critique-suggestions></ol></section>
      </article>
      <div class="darkroom-error" data-critique-error hidden role="alert"><h3>暂时没能完成分析</h3><p data-critique-error-text></p><button type="button" class="darkroom-button" data-critique-retry>重试分析</button></div>
    </section>
  </div>
  <p class="lab-sr-only" data-critique-status role="status" aria-live="polite"></p>
  <p class="darkroom-privacy">本地压缩并清除 EXIF 后实时分析，本站不保存照片 · 由 <a href="https://developers.cloudflare.com/workers-ai/" target="_blank" rel="noopener noreferrer">Cloudflare Workers AI</a> 驱动 · Built with Llama</p>
  <dialog id="critique-share-preview" class="darkroom-share" data-critique-share aria-labelledby="critique-share-title">
    <header><h2 id="critique-share-title">评片分享报告</h2><button type="button" data-critique-share-close autofocus aria-label="关闭报告预览">关闭 ×</button></header>
    <p class="darkroom-share-hint" data-critique-share-hint role="status" aria-live="polite">正在生成分享图片…</p>
    <div class="darkroom-share-scroll"><img data-critique-share-image width="1080" height="2200" loading="lazy" decoding="async" hidden alt="AI 评片分享报告，含照片、四维分析、建议和网站二维码，可长按保存"/></div>
    <footer><a class="darkroom-button" data-critique-download download hidden>下载报告图片</a><button type="button" class="darkroom-button darkroom-secondary" data-critique-native-share hidden>分享图片</button></footer>
  </dialog>
</div>
