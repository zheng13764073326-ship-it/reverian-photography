 .optical-telemetry{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:5px}.telemetry-histogram,.telemetry-spectrum{padding:11px 16px 16px;min-width:0}.telemetry-histogram svg{display:block;width:100%;height:90px}.histogram-grid{stroke:#aeb8ae60;stroke-width:.7}.histogram-area{fill:#23748935;stroke:var(--focus-color);stroke-width:1.1}.histogram-marker{stroke:var(--miss-color);stroke-width:.8;stroke-dasharray:2 2}.histogram-axis{display:flex;justify-content:space-between;font:7px var(--quiz-mono);color:var(--muted);margin-top:2px}.optical-caption{font:10px/1.8 var(--quiz-mono);color:var(--muted);margin:12px 0 0;overflow-wrap:anywhere}
 .optical-spectrum{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;margin-top:16px;min-height:57px}.optical-swatch{padding:0;min-width:0;position:relative;height:36px;border:1px solid #26272220;border-radius:0}.optical-swatch span{position:absolute;top:calc(100% + 7px);left:50%;transform:translateX(-50%);font:8px var(--quiz-mono);color:var(--muted);white-space:nowrap}.optical-swatch:focus-visible,.optical-swatch[aria-pressed=true]{outline:1px solid var(--focus-color);outline-offset:3px}.color-value{font:8px var(--quiz-mono);color:var(--muted);min-height:10px;margin:7px 0 14px;text-align:right}.temperature-scale{height:4px;position:relative;background:var(--line);margin-top:11px}.temperature-scale i{position:absolute;top:-5px;left:var(--temperature,50%);width:1px;height:14px;background:var(--ink);visibility:hidden}.temperature-scale[data-ready] i{visibility:visible}.thermal-caption{display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px;font:8px/1.8 var(--quiz-mono);color:var(--muted);margin:8px 0 0}
