 .reticle{position:relative;width:clamp(125px,15vw,174px);flex:none;aspect-ratio:1}.reticle>svg{display:block;width:100%;fill:none;stroke:#91a19b;stroke-width:.6}.reticle .ring-inner{stroke:#23748920}.reticle .ring-score{stroke:var(--focus-color);stroke-width:1.4;stroke-dasharray:var(--focus-score,0) 100}.optical-report .score{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;margin:0;font:400 clamp(48px,5vw,65px)/1 var(--quiz-mono);color:var(--focus-color);font-variant-numeric:tabular-nums}.optical-report .score-unit{font:10px var(--quiz-mono);color:var(--muted)}
 .radar-body{display:grid;grid-template-columns:minmax(0,1fr) 32px;align-items:center;gap:4px;min-height:220px}.radar-body>div:first-child{min-width:0}.radar-body [data-radar]{display:block;width:100%}.radar-grid{fill:none;stroke:#aeb8ae;stroke-width:.65}.radar-area{fill:#9a601f25;stroke:var(--miss-color);stroke-width:1.2}.radar-dot{fill:var(--miss-color)}.radar-body text{font:14px var(--quiz-mono);fill:var(--ink);text-anchor:middle}.radar-key{font:8px/1.7 var(--quiz-mono);color:var(--muted);text-align:center;margin:0}.relative-exposure{border-left:1px solid #aeb8ae70;padding-left:5px;align-self:stretch;display:flex;flex-direction:column;justify-content:center}.relative-exposure svg{width:100%;height:180px;fill:none;stroke:var(--muted);stroke-width:.7}.relative-exposure text{fill:var(--muted);stroke:none;font:10px var(--quiz-mono);text-anchor:start}.relative-exposure [data-ev-pointer]{stroke:none;fill:var(--miss-color);visibility:hidden}.relative-exposure[data-ready] [data-ev-pointer]{visibility:visible}.relative-exposure>span{font:6px var(--quiz-mono);text-align:center;white-space:nowrap;color:var(--muted)}
 .optical-lock{position:absolute;inset:18px;pointer-events:none;opacity:0}.optical-lock i{position:absolute;width:18px;height:18px;border-style:solid;border-color:var(--focus-color);border-width:0}.optical-lock i:nth-child(1){top:0;left:0;border-width:1px 0 0 1px}.optical-lock i:nth-child(2){top:0;right:0;border-width:1px 1px 0 0}.optical-lock i:nth-child(3){bottom:0;left:0;border-width:0 0 1px 1px}.optical-lock i:nth-child(4){bottom:0;right:0;border-width:0 1px 1px 0}.is-focusing .optical-lock{animation:report-lock 1s ease both}.is-focusing .sync-body{animation:report-clarity 1s ease both}.optical-fold{display:grid;grid-template-rows:1fr;opacity:1;transition:grid-template-rows .55s ease,opacity .5s ease}.optical-fold>div{min-height:0;overflow:hidden}.is-focusing .optical-fold{grid-template-rows:0fr;opacity:0}.is-focusing [data-result-details]{display:none}
 .optical-wave{padding:10px 16px 13px;margin-bottom:5px}.optical-label{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:9px}.wave-key{display:flex;align-items:center;gap:13px}.wave-key b{font-weight:400;color:var(--focus-color)}.wave-key b:nth-child(2){color:var(--miss-color)}.wave-key em{font-style:normal;font-size:9px;color:var(--muted)}.wave-viewport{overflow-x:auto;scrollbar-width:thin}.wave-viewport svg{display:block;width:100%;min-width:280px}.wave-grid{stroke:#237489;stroke-opacity:.12;stroke-width:.6}.wave-reference{stroke:#237489;stroke-opacity:.18;stroke-width:1;stroke-dasharray:1 5}.wave-mine,.wave-visitor{fill:none;stroke-width:1.2;stroke:var(--focus-color)}.wave-visitor{stroke:var(--miss-color);stroke-dasharray:4 3}.wave-node{cursor:pointer;outline:none}.wave-hit{fill:transparent}.wave-dot{stroke:var(--focus-color);stroke-width:1.2;fill:var(--paper);transform-box:fill-box;transform-origin:center;transition:transform .2s}.wave-dot.visitor{stroke:var(--miss-color)}.wave-node[data-correct=true] .wave-dot{fill:var(--focus-color)}.wave-node text{fill:var(--muted);font:12px var(--quiz-mono);text-anchor:middle}.wave-node .node-code{font-size:6px;fill:var(--focus-color);opacity:.7}.wave-node[data-correct=false] .node-code{fill:var(--miss-color)}.wave-node.is-active .wave-dot,.wave-node:focus-visible .wave-dot{transform:scale(1.7)}.wave-node.is-active text,.wave-node:focus-visible text{fill:var(--focus-color);font-weight:700}.wave-node:focus-visible .wave-hit{stroke:var(--focus-color);stroke-width:.8}
