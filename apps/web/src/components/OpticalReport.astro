 [data-result-details]{padding:0 6px}.quiz-review li{scroll-margin-top:calc(var(--header) + 24px);transition:background .22s,border-color .22s,box-shadow .22s;outline:none}.tacit .quiz-review li.is-active,.tacit .quiz-review li:focus-visible{border-color:var(--focus-color);background:#23748908;box-shadow:inset 3px 0 var(--focus-color)}.tacit .quiz-review li[data-correct=false].is-active{border-color:var(--miss-color);background:#9a601f08;box-shadow:inset 3px 0 var(--miss-color)}
