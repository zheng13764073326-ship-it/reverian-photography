 @keyframes report-lock{0%{opacity:.3;transform:scale(1.07)}65%{opacity:.7;transform:scale(1)}80%{opacity:1}88%{opacity:.25}100%{opacity:1;transform:scale(1)}}@keyframes report-clarity{from{filter:blur(2px)}65%,to{filter:blur(0)}}
 @media(max-width:700px){.sync-body{flex-direction:column;gap:8px;min-height:0}.sync-copy{width:100%;text-align:center}.optical-eyebrow{display:none}.tacit .optical-report .result-kicker{font-size:20px;margin-bottom:7px}.optical-report [data-result-message]{font-size:13px;line-height:1.8}.reticle{width:125px}.optical-report .score{font-size:48px}.radar-body{height:calc(100% - 28px);min-height:0}.radar-key{font-size:7px}.wave-node text{font-size:17px}.wave-node .node-code{font-size:7px}.optical-spectrum{gap:3px}.optical-swatch span{font-size:7px}.optical-caption{font-size:9px}.optical-top{font-size:8px;padding:10px}.optical-top>span:first-child{max-width:75%}.optical-top b{padding:0 3px}.lab-lock{font-size:7px}.optical-footer{font-size:8px}.archive-codes{gap:5px}.archive-codes>svg{width:68px;height:18px}.report-qr{width:49px}}
 @media(max-width:450px){.optical-report{padding:3px}.optical-cabins{grid-template-columns:56fr 44fr;gap:3px;margin-bottom:3px}.sync-cabin,.radar-cabin{padding:8px 8px 13px}.module-label,.optical-label{font-size:8px}.module-label{margin-bottom:7px}.reticle{width:105px}.optical-report .score{font-size:42px}.optical-report .score-unit{font-size:8px}.tacit .optical-report .result-kicker{font-size:18px;letter-spacing:.03em}.optical-report [data-result-message]{font-size:12px;line-height:1.8}.radar-body{grid-template-columns:minmax(0,1fr) 20px;gap:0}.relative-exposure{padding-left:2px}.relative-exposure svg{height:150px}.relative-exposure>span{font-size:5px}.radar-body text{font-size:17px}.radar-key{font-size:6px;line-height:1.8}.optical-top{margin-bottom:3px;font-size:7px}.optical-top b{display:none}.optical-top [data-report-id]{display:block;letter-spacing:.03em}.optical-wave{padding:8px 8px 11px;margin-bottom:3px}.wave-key{gap:7px}.wave-key em{font-size:7px}.wave-viewport svg{min-width:265px}.optical-picture{padding:0 7px;margin-bottom:3px}.film-edge{font-size:7px;padding:5px 0}.film-edge.bottom{font-size:7px;padding:5px 0}.film-edge.bottom>span:last-child{display:none}.optical-photo-frame{padding:3px}.viewfinder{width:12px;height:12px}.optical-telemetry{gap:3px;margin-bottom:3px}.telemetry-histogram,.telemetry-spectrum{padding:8px 8px 13px}.telemetry-histogram svg{height:72px}.optical-label{gap:4px}.telemetry-spectrum .optical-label{display:block}.telemetry-spectrum [data-analysis-state]{font-size:7px}.optical-spectrum{margin-top:8px;gap:3px;min-height:45px}.optical-swatch{height:27px}.optical-swatch span{font-size:5px;letter-spacing:-.04em}.color-value{font-size:7px;margin:4px 0 12px}.thermal-caption{font-size:6px;gap:2px;letter-spacing:-.02em}.optical-caption{font-size:8px;margin-top:10px}.histogram-axis{font-size:6px}.optical-footer{padding:8px;font-size:7px;gap:6px}.archive-codes>svg{width:44px;height:16px}.report-qr{width:45px}.result-actions [data-export-report]{width:100%}}
 @media(prefers-reduced-motion:reduce){.optical-report,.optical-fold,.wave-dot,.quiz-review li{transition:none!important}.is-focusing .optical-lock,.is-focusing .sync-body{animation:none!important}}
</style>
<style is:global>
 .tacit .quiz-frame.show-result{max-width:620px}
 .optical-report .optical-top{padding:9px 12px}
 .optical-report .optical-cabins{grid-template-columns:1fr 1fr}
 .optical-report .sync-cabin,.optical-report .radar-cabin{padding:8px 10px 13px}
 .optical-report .module-label{margin-bottom:3px}
