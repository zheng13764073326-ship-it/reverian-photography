<div class="erhai-ambience" data-state="idle">
 <button type="button" class="ambience-toggle" aria-pressed="false" aria-label="播放15秒洱海实录：听见洱海的风">
  <svg class="ambience-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 14v-3a8 8 0 0 1 16 0v3M4 13H3v7h4v-7H4Zm16 0h1v7h-4v-7h3Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="ambience-label">听见洱海的风</span>
  <span class="ambience-bars" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="ambience-time" aria-hidden="true">00:15</span>
 </button>
 <span class="ambience-caption">洱海公园 · 现场录音</span>
 <details class="ambience-credit"><summary>声音来源</summary><p><a href="https://freesound.org/people/lulocasero/sounds/666936/" target="_blank" rel="noopener noreferrer">DALI erhai 大理洱海公园</a>，录制：Linlin Wang；编辑：Luis López Casero（lulocasero）。<a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC 4.0</a>，仅限非商业使用。本页选取 15 秒，并加入淡入淡出。</p></details>
 <span class="ambience-status" role="status" aria-live="polite"></span>
 <audio preload="none" src="/audio/erhai-field-15s.wav" hidden></audio>
</div>
<script>
const root=document.querySelector<HTMLElement>('.erhai-ambience');
if(root){
 const button=root.querySelector<HTMLButtonElement>('button')!,audio=root.querySelector<HTMLAudioElement>('audio')!;
 const label=root.querySelector<HTMLElement>('.ambience-label')!,time=root.querySelector<HTMLElement>('.ambience-time')!,status=root.querySelector<HTMLElement>('.ambience-status')!;
 let active=false,request=0;
 audio.volume=.55;
 const stop=(message='风声已停止。')=>{
  request++;active=false;audio.pause();
  if(audio.readyState>0)audio.currentTime=0;
  root.dataset.state='idle';button.setAttribute('aria-pressed','false');button.removeAttribute('aria-busy');
  button.setAttribute('aria-label','播放15秒洱海实录：听见洱海的风');label.textContent='听见洱海的风';time.textContent='00:15';status.textContent=message;
 };
 button.addEventListener('click',async()=>{
  if(active){stop();return;}
  const token=++request;active=true;root.dataset.state='loading';button.setAttribute('aria-pressed','true');button.setAttribute('aria-busy','true');
  button.setAttribute('aria-label','停止洱海实录');label.textContent='风声将至…';status.textContent='正在准备洱海实录。';
  try{
   await audio.play();
   if(token!==request)return;
   root.dataset.state='playing';button.removeAttribute('aria-busy');label.textContent='让风歇一会';status.textContent='洱海实录正在播放，15秒后自动结束，再次点击可停止。';
  }catch{
   if(token!==request)return;
   stop('暂时无法播放，请再试一次。');root.dataset.state='error';label.textContent='再听一次风声';
  }
 });
 audio.addEventListener('timeupdate',()=>{
  if(!active)return;
  const seconds=Math.max(0,Math.ceil((Number.isFinite(audio.duration)?audio.duration:15)-audio.currentTime));
  time.textContent=`00:${String(seconds).padStart(2,'0')}`;
 });
 audio.addEventListener('ended',()=>stop('这一阵风已结束。'));
 audio.addEventListener('error',()=>{if(active){stop('暂时无法播放，请再试一次。');root.dataset.state='error';label.textContent='再听一次风声';}});
 document.addEventListener('visibilitychange',()=>{if(document.hidden&&active)stop();});
 window.addEventListener('pagehide',()=>stop(''));
}
</script>
<style>
 .erhai-ambience{display:flex;align-items:center;flex-wrap:wrap;gap:12px 18px;margin:-8px 0 28px;color:var(--muted)}
 .ambience-toggle{display:inline-flex;align-items:center;gap:12px;min-height:44px;padding:9px 14px;border:1px solid var(--line);border-radius:2px;font-family:var(--serif-zh);font-size:16px;line-height:1.5;letter-spacing:.06em;color:var(--ink);transition:border-color .2s,background .2s}
 .ambience-toggle:hover,.ambience-toggle[aria-pressed=true]{border-color:#b3a18a;background:rgba(148,127,98,.06)}
 .ambience-icon{width:20px;height:20px;flex:none;color:#907b62}
 .ambience-time{font-family:'Courier New',monospace;font-size:13px;letter-spacing:.02em;color:var(--muted);font-variant-numeric:tabular-nums;min-width:5ch}
 .ambience-caption{font-family:var(--serif-zh);font-size:14px;letter-spacing:.08em}
 .ambience-credit{font-family:var(--serif-zh);font-size:13px;line-height:1.8}
 .ambience-credit summary{cursor:pointer;text-underline-offset:4px;text-decoration:underline;text-decoration-color:var(--line)}
 .ambience-credit[open]{flex-basis:100%;max-width:760px}
 .ambience-credit p{margin:8px 0 0}.ambience-credit a{text-decoration:underline;text-underline-offset:3px}
 .ambience-bars{display:none;align-items:center;gap:3px;height:16px;color:#907b62}
 .ambience-bars i{display:block;width:2px;height:12px;background:currentColor;animation:wind-bar 1.4s ease-in-out infinite alternate}
 .ambience-bars i:nth-child(2){animation-delay:-.5s;height:16px}.ambience-bars i:nth-child(3){animation-delay:-1s}
 [data-state=playing] .ambience-bars{display:flex}
 [data-state=playing] .ambience-icon{display:none}
 .ambience-status{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 [data-state=error] .ambience-status{position:static;width:auto;height:auto;clip-path:none;white-space:normal;font-size:14px;color:var(--muted);flex-basis:100%}
 @keyframes wind-bar{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
 @media(max-width:600px){.erhai-ambience{margin:-4px 0 24px;gap:8px 12px}.ambience-toggle{font-size:16px;gap:10px}.ambience-caption{font-size:13px}}
 @media(prefers-reduced-motion:reduce){.ambience-toggle{transition:none}.ambience-bars i{animation:none}}
</style>
