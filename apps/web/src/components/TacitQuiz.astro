---
import {tacitQuestions} from '../lib/tacit';
---
<section id="tacit" class="tacit" aria-label="默契度测试">
  <div class="tacit-intro">
    <button type="button" class="quiz-entry" data-start hidden><strong>测测我们的默契度</strong><span>十道题，看看你多懂我</span><span aria-hidden="true">→</span></button>
    <noscript><p>请开启浏览器的 JavaScript 来参与测试。</p></noscript>
  </div>
  <form class="quiz-name-card" data-name-form hidden>
    <p class="name-kicker">默契度测试</p>
    <h2>先告诉我你的名字</h2>
    <label class="name-label" for="quiz-name">名字或昵称</label>
    <input id="quiz-name" name="nickname" autocomplete="nickname" maxlength="32" required placeholder="你的名字"/>
    <button type="submit" class="quiz-action">开始答题</button>
  </form>
  <div class="quiz-frame" data-frame hidden>
    <i class="corner tl" aria-hidden="true"></i><i class="corner tr" aria-hidden="true"></i><i class="corner bl" aria-hidden="true"></i><i class="corner br" aria-hidden="true"></i>
    <div class="frame-meta"><span data-counter>Q 01 / 10</span><span class="focus-mark" aria-hidden="true">AF-C</span><span data-focus>合焦 0 / 10</span></div>
    <progress max={tacitQuestions.length} value="0" aria-label="已完成题数" data-progress></progress>
    <div data-question-screen>
      <h3 tabindex="-1" data-question></h3>
      <p class="choice-hint" id="tacit-choice-hint" data-hint></p>
      <div class="quiz-options" role="group" aria-labelledby="tacit-question" aria-describedby="tacit-choice-hint" data-options></div>
      <div class="feedback" aria-live="polite" aria-atomic="true" data-feedback></div>
      <div class="quiz-controls"><button type="button" class="quiz-action" data-confirm disabled>确认选择</button><button type="button" class="quiz-action" data-next hidden>下一题 →</button></div>
      <div class="quiz-verdict" data-verdict hidden aria-hidden="true"><span class="verdict-word" data-verdict-word></span><span class="verdict-sub" data-verdict-sub></span></div>
    </div>
    <div class="quiz-result" data-result hidden>
      <h3 class="result-kicker" tabindex="-1" data-result-title>合焦完成</h3>
      <p class="score"><span data-score>0</span><span class="score-unit"> / 10 合焦</span></p>
      <p data-result-message></p>
      <p class="save-note" role="status" data-save-note></p>
      <button class="quiz-action" type="button" data-save-retry hidden>重试保存</button>
      <div id="tacit-review" class="quiz-review"><ol data-review aria-label="逐题答案对照"></ol></div>
      <div class="result-actions"><button type="button" class="quiz-action" data-restart>再测一次</button><a class="quiz-action" href="/about/">回到简介</a></div>
    </div>
  </div>
</section>

<script>
  import {tacitQuestions, isInFocus, tacitScore, QUIZ_VERSION} from '../lib/tacit';
  const root = document.querySelector<HTMLElement>('#tacit');
  if (root) {
    const get = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const start = get<HTMLButtonElement>('[data-start]');
    const nameForm = get<HTMLFormElement>('[data-name-form]');
    const nameInput = get<HTMLInputElement>('#quiz-name');
    const frame = get('[data-frame]');
    const title = get('[data-question]');
    title.id = 'tacit-question';
    const options = get('[data-options]');
    const feedback = get('[data-feedback]');
    const confirm = get<HTMLButtonElement>('[data-confirm]');
    const next = get<HTMLButtonElement>('[data-next]');
    const progress = get<HTMLProgressElement>('[data-progress]');
    let index = 0;
    let picks: number[] = [];
    let answers: number[][] = [];
    let revealed = false;
    let nickname = '';
    let attemptId = '';
    let submission: {id:string;name:string;version:string;answers:number[][]} | undefined;
    let saving = '';
    let advanceTimer: ReturnType<typeof setTimeout> | undefined;
    const clearAdvance = () => { clearTimeout(advanceTimer); advanceTimer = undefined; };
    const focus = (element: HTMLElement) => {
      element.focus({preventScroll:true});
      frame.scrollIntoView({block:'start', behavior:'instant'});
    };
    const renderQuestion = () => {
      clearAdvance();
      get('[data-verdict]').hidden = true;
      get('.focus-mark').textContent = 'AF-C';
      revealed = false;
      picks = [];
      frame.removeAttribute('data-state');
      const question = tacitQuestions[index];
      get('[data-counter]').textContent = `Q ${String(index + 1).padStart(2,'0')} / ${tacitQuestions.length}`;
      title.textContent = question.question;
      get('[data-hint]').textContent = question.answers.length > 1 ? `多选 · 请选择 ${question.answers.length} 项` : '单选';
      options.replaceChildren();
      question.options.forEach((label, i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'quiz-option';
        button.setAttribute('aria-pressed','false');
        const letter = document.createElement('span');
        letter.className = 'option-letter';
        letter.textContent = String.fromCharCode(65+i);
        letter.setAttribute('aria-hidden','true');
        const text = document.createElement('span');
        text.textContent = label;
        const mark = document.createElement('span');
        mark.className = 'option-mark';
        button.append(letter,text,mark);
        button.addEventListener('click', () => {
          if (revealed) return;
          if (question.answers.length === 1) {
            picks = [i];
          } else if (picks.includes(i)) {
            picks = picks.filter(p => p !== i);
          } else if (picks.length < question.answers.length) {
            picks.push(i);
          } else {
            feedback.textContent = `已选 ${question.answers.length} 项，先取消一项即可更换。`;
            return;
          }
          [...options.children].forEach((option,j) => option.setAttribute('aria-pressed',String(picks.includes(j))));
          confirm.disabled = picks.length !== question.answers.length;
          feedback.textContent = '';
          if (question.answers.length === 1) reveal();
        });
        options.append(button);
      });
      feedback.textContent = '';
      confirm.hidden = question.answers.length === 1;
      confirm.disabled = true;
      next.hidden = true;
      next.textContent = index === tacitQuestions.length - 1 ? '查看得分 →' : '下一题 →';
      focus(title);
    };
    const reveal = () => {
      const question = tacitQuestions[index];
      if (revealed || picks.length !== question.answers.length) return;
      revealed = true;
      answers[index] = [...picks];
      const correct = isInFocus(question,picks);
      frame.dataset.state = correct ? 'focused' : 'missed';
      const word = correct ? '合焦' : '失焦';
      const af = correct ? 'AF-LOCK' : 'AF-HUNT';
      get('.focus-mark').textContent = af;
      feedback.textContent = word;
      get('[data-verdict-word]').textContent = word;
      get('[data-verdict-sub]').textContent = af;
      get('[data-verdict]').hidden = false;
      [...options.children].forEach((option,i) => {
        const button = option as HTMLButtonElement;
        button.disabled = true;
        button.classList.toggle('is-answer',question.answers.includes(i));
        button.classList.toggle('is-miss',picks.includes(i) && !question.answers.includes(i));
        const mark = button.querySelector('.option-mark')!;
        mark.textContent = question.answers.includes(i) ? '✓' : picks.includes(i) ? '×' : '';
        button.setAttribute('aria-label',`${question.options[i]}${question.answers.includes(i)?'，正确答案':''}${picks.includes(i)?'，你的选择':''}`);
      });
      progress.value = index + 1;
      get('[data-focus]').textContent = `合焦 ${answers.filter((answer,i) => isInFocus(tacitQuestions[i],answer)).length} / ${tacitQuestions.length}`;
      confirm.hidden = true;
      next.hidden = false;
      next.focus({preventScroll:true});
      advanceTimer = setTimeout(advance,1400);
    };
    const showResult = () => {
      clearAdvance();
      revealed = false;
      get('[data-verdict]').hidden = true;
      get('[data-question-screen]').hidden = true;
      get('[data-result]').hidden = false;
      frame.removeAttribute('data-state');
      frame.classList.add('show-result');
      get('[data-counter]').textContent = '10 / 10 · 完成';
      const score = tacitScore(tacitQuestions,answers);
      get('[data-score]').textContent = String(score / 10);
      get('[data-result-message]').textContent = score === 100 ? '全部合焦。看来你真的很了解我。' : score >= 70 ? '不少答案都猜中了，我们还挺有默契。' : score >= 40 ? '有些猜中了，有些刚刚认识。谢谢你愿意了解我。' : '没关系，就当是我们认识的开始。';
      const review = get('[data-review]');
      review.replaceChildren();
      tacitQuestions.forEach((question,i) => {
        const item = document.createElement('li');
        const correct = isInFocus(question,answers[i]);
        const head = document.createElement('div');
        head.className = 'review-head';
        const number = document.createElement('span');
        number.textContent = `Q ${String(i+1).padStart(2,'0')}`;
        const heading = document.createElement('h5');
        heading.textContent = question.question;
        const state = document.createElement('span');
        state.className = correct ? 'review-focus' : 'review-miss';
        state.textContent = correct ? '合焦' : '失焦';
        head.append(number,state);
        const selection = document.createElement('p');
        selection.className = 'review-comparison';
        const you = document.createElement('span');
        you.className = correct ? 'review-focus' : 'review-miss';
        you.textContent = answers[i].map(p => question.options[p]).join('、');
        const mine = document.createElement('strong');
        mine.className = 'review-focus';
        mine.textContent = question.answers.map(p => question.options[p]).join('、');
        selection.append('你选 ',you,' → 我选 ',mine);
        item.append(head,heading,selection);
        review.append(item);
      });
      focus(get('[data-result-title]'));
      submission = {id:attemptId,name:nickname,version:QUIZ_VERSION,answers:answers.map(answer=>[...answer])};
      void saveResult();
    };
    const saveResult = async () => {
      if (!submission || saving === submission.id) return;
      const current = submission;
      saving = current.id;
      get('[data-save-retry]').hidden = true;
      get('[data-save-note]').textContent = '正在保存答题记录…';
      try {
        const response = await fetch('/api/quiz',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(current),signal:AbortSignal.timeout(15000)});
        const result = await response.json();
        if (!response.ok || !result.saved) throw Error(result.error || '暂时没能保存');
        if (submission===current) get('[data-save-note]').textContent = '答题记录已保存，仅站长可见。';
      } catch {
        if (submission===current) {
          get('[data-save-note]').textContent = '答题记录暂未保存，你可以重试。';
          get('[data-save-retry]').hidden = false;
        }
      } finally { if (saving === current.id) saving = ''; }
    };
    const showName = () => {
      clearAdvance();
      frame.hidden = true;
      get('.tacit-intro').hidden = true;
      nameForm.hidden = false;
      nameInput.value = nickname;
      nameInput.focus();
      nameForm.scrollIntoView({block:'center',behavior:'instant'});
    };
    const begin = () => {
      clearAdvance();
      get('.tacit-intro').hidden = true;
      frame.classList.remove('show-result');
      nickname = nameInput.value.trim();
      nameForm.hidden = true;
      attemptId = crypto.randomUUID();
      submission = undefined;
      get('[data-save-note]').textContent = '';
      get('[data-save-retry]').hidden = true;
      index = 0;
      answers = [];
      progress.value = 0;
      get('[data-focus]').textContent = '合焦 0 / 10';
      get('[data-result]').hidden = true;
      get('[data-question-screen]').hidden = false;
      start.hidden = true;
      frame.hidden = false;
      renderQuestion();
    };
    start.hidden = false;
    start.addEventListener('click',showName);
    get('[data-restart]').addEventListener('click',showName);
    nameForm.addEventListener('submit',event=>{
      event.preventDefault();
      nameInput.setCustomValidity('');
      if (!nameInput.value.trim() || /[\u0000-\u001f\u007f]/.test(nameInput.value)) nameInput.setCustomValidity('请填写名字或昵称');
      if (nameForm.reportValidity()) begin();
    });
    nameInput.addEventListener('input',()=>nameInput.setCustomValidity(''));
    get('[data-save-retry]').addEventListener('click',()=>void saveResult());
    confirm.addEventListener('click',reveal);
    function advance() {
      if (!revealed) return;
      clearAdvance();
      revealed = false;
      index++;
      if (index === tacitQuestions.length) showResult(); else renderQuestion();
    }
    next.addEventListener('click',advance);
    window.addEventListener('pagehide',clearAdvance);
  }
</script>

<style>
 .tacit{--focus-color:#237489;--miss-color:#9a601f;--quiz-mono:ui-monospace,Consolas,monospace;margin:44px 0;scroll-margin-top:calc(var(--header) + 24px)}
 .tacit-intro{display:flex;justify-content:center}.quiz-entry{display:flex;align-items:center;gap:20px;max-width:100%;padding:18px 30px;border:1px solid #aabebc;border-radius:999px;line-height:1.6}.quiz-entry strong{font-size:17px;font-weight:500;color:var(--focus-color)}.quiz-entry>span{font-size:14px;color:var(--muted)}.quiz-entry>span:last-child{font-size:23px;color:var(--focus-color)}.quiz-entry:hover{background:#e8ece4;border-color:var(--focus-color)}
 .tacit h2,.tacit h3{font-family:var(--serif-zh)}.tacit h2{font-size:clamp(25px,3vw,34px);margin-bottom:28px}.quiz-name-card{max-width:640px;margin:auto;border:1px solid #c8d1cd;border-radius:4px;padding:36px}.name-kicker{font:12px var(--quiz-mono);letter-spacing:.3em;color:var(--focus-color);margin-bottom:20px}.name-label{display:block;font-size:12px;color:var(--muted);margin-bottom:8px}.quiz-name-card input{width:100%;background:transparent;border:0;border-bottom:1px solid var(--focus-color);font:18px var(--sans);color:var(--ink);padding:10px 2px;outline-offset:5px}.quiz-name-card input:focus-visible{outline:2px solid var(--focus-color)}.save-note{font-size:12px;color:var(--muted);margin:16px 0 24px}.quiz-name-card .quiz-action{margin-top:24px;width:100%;background:var(--focus-color);border-color:var(--focus-color);color:var(--paper)}
 .quiz-action{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:24px;border:1px solid #adbabc;border-radius:3px;padding:10px 24px;font-size:14px;letter-spacing:.12em}.quiz-action:hover{background:#e4e9e5;border-color:var(--focus-color)}.quiz-action:disabled{opacity:.4;cursor:default}
 .quiz-frame{position:relative;max-width:760px;min-height:450px;margin:0 auto;padding:28px 30px 24px;border:1px solid #c8d1cd;border-radius:4px;scroll-margin-top:calc(var(--header) + 24px)}
 .corner{position:absolute;width:16px;height:16px;border-color:var(--focus-color);border-style:solid;border-width:0;pointer-events:none;opacity:.9}
 .tl{top:-1px;left:-1px;border-top-width:2px;border-left-width:2px}.tr{top:-1px;right:-1px;border-top-width:2px;border-right-width:2px}.bl{bottom:-1px;left:-1px;border-bottom-width:2px;border-left-width:2px}.br{bottom:-1px;right:-1px;border-bottom-width:2px;border-right-width:2px}
 .frame-meta{display:flex;align-items:center;justify-content:space-between;font:11px var(--quiz-mono);letter-spacing:.1em;color:var(--muted);gap:12px}.focus-mark::before{content:'●';margin-right:6px;color:var(--focus-color);font-size:8px}
 progress{display:block;width:100%;height:2px;margin:22px 0 26px;border:0;appearance:none;background:var(--line);color:var(--focus-color)}progress::-webkit-progress-bar{background:var(--line)}progress::-webkit-progress-value{background:var(--focus-color)}progress::-moz-progress-bar{background:var(--focus-color)}
 .tacit h3{font-size:clamp(21px,2.5vw,27px);line-height:1.55;margin-bottom:10px;outline:none}.choice-hint{font:11px var(--quiz-mono);color:var(--focus-color);margin-bottom:20px;letter-spacing:.12em}
 .quiz-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quiz-options :global(.quiz-option){display:grid;grid-template-columns:16px 1fr 18px;align-items:center;gap:12px;min-height:64px;padding:14px 16px;text-align:left;border:1px solid #c8d1cd;border-radius:3px;font-size:14px;line-height:1.6;transition:border-color .2s,background .2s}
 .quiz-options :global(.option-letter){font:12px var(--quiz-mono);color:var(--muted)}.quiz-options :global(.option-mark){font-size:15px}.quiz-options :global(.quiz-option:not(:disabled):hover),.quiz-options :global([aria-pressed=true]){border-color:var(--focus-color);background:#e4eae6}
 .quiz-options :global(.is-answer){border-color:var(--focus-color);background:#e0eae5;color:var(--focus-color)}.quiz-options :global(.is-miss){border-color:var(--miss-color);background:#eee3d4;color:var(--miss-color)}.quiz-options :global(button:disabled){cursor:default}.quiz-options :global(button:disabled:not(.is-answer):not(.is-miss)){opacity:.45}
 .feedback{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
 .quiz-controls{display:flex;justify-content:flex-end;margin-top:24px;min-height:46px}
 [data-state=focused] .corner{animation:corner-lock .42s ease-out}[data-state=missed] .corner{border-color:var(--miss-color)}[data-state=focused] .focus-mark{color:var(--focus-color)}[data-state=missed] .focus-mark,[data-state=missed] .focus-mark::before{color:var(--miss-color)}
 .quiz-verdict{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:rgba(244,241,233,.93);border-radius:4px;pointer-events:none;animation:verdict-pop .34s cubic-bezier(.22,1,.36,1)}
 .verdict-word{font-family:var(--serif-zh);font-size:clamp(46px,9vw,88px);font-weight:700;letter-spacing:.14em;padding-left:.14em;line-height:1.2;color:var(--focus-color)}.verdict-sub{font:12px var(--quiz-mono);letter-spacing:.32em;color:var(--focus-color)}.verdict-sub::before{content:'●';font-size:9px;margin-right:10px}[data-state=missed] .verdict-word,[data-state=missed] .verdict-sub{color:var(--miss-color)}
 .show-result{max-width:800px;padding:42px 28px}.show-result>.corner,.show-result>.frame-meta,.show-result>progress{display:none}.quiz-result{text-align:center}.tacit .result-kicker{font-size:15px;letter-spacing:.34em;color:var(--focus-color);margin:0 0 24px}.score{font:700 clamp(56px,9vw,76px)/1 var(--quiz-mono);color:var(--focus-color);margin:0 0 26px}.score-unit{font:14px var(--quiz-mono);letter-spacing:.14em;color:var(--muted)}[data-result-message]{font:17px/2 var(--serif-zh);margin:0 auto 36px;max-width:34em}
 .result-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:16px;margin-top:38px}.result-actions [data-restart]{background:var(--focus-color);border-color:var(--focus-color);color:var(--paper)}.result-actions [data-restart]:hover{background:#1e6375}
 .quiz-review ol{display:grid;grid-template-columns:1fr;gap:14px;list-style:none;padding:0;margin:0;text-align:left}.quiz-review :global(li){padding:20px;border:1px solid #c8d1cd;border-radius:3px}.quiz-review :global(.review-head){display:flex;justify-content:space-between;gap:12px;font:12px var(--quiz-mono);letter-spacing:.14em;color:var(--muted);margin-bottom:14px}.quiz-review :global(h5){font:16px/1.6 var(--sans);margin:0 0 12px}.quiz-review :global(.review-comparison){font-size:14px;line-height:1.9;color:var(--muted);margin:0;overflow-wrap:anywhere}.quiz-review :global(.review-focus){color:var(--focus-color)}.quiz-review :global(.review-miss){color:var(--miss-color)}.quiz-review :global(.review-comparison .review-focus){font-weight:600}
 @keyframes verdict-pop{0%{opacity:0;transform:scale(.55);filter:blur(12px)}55%{opacity:1;filter:blur(0)}100%{opacity:1;transform:scale(1);filter:blur(0)}}
 @keyframes corner-lock{0%{transform:scale(1.9);opacity:.25}60%{transform:scale(.94);opacity:1}100%{transform:scale(1);opacity:.9}}
 @media(max-width:600px){.tacit{margin:32px 0}.quiz-entry{display:grid;grid-template-columns:1fr auto;gap:2px 16px;padding:15px 24px;text-align:left}.quiz-entry strong{font-size:16px}.quiz-entry>span:nth-child(2){font-size:12px;grid-column:1}.quiz-entry>span:last-child{grid-column:2;grid-row:1/3}.quiz-name-card{padding:26px 20px}.quiz-frame{padding:24px 18px;min-height:0}.quiz-options{grid-template-columns:1fr;gap:10px}.quiz-options :global(.quiz-option){min-height:54px;padding:12px}.frame-meta{font-size:10px;letter-spacing:0;gap:6px}.tacit h3{font-size:21px}.show-result{padding:32px 14px}.quiz-review :global(li){padding:16px}.quiz-review :global(h5){font-size:15px}.quiz-review :global(.review-comparison){font-size:13px}.score-unit{font-size:12px}.result-actions{gap:12px}.result-actions .quiz-action{padding:10px 18px}.quiz-controls .quiz-action{width:100%}}
 @media(prefers-reduced-motion:reduce){.quiz-options :global(.quiz-option){transition:none}.corner,.quiz-verdict{animation:none!important}}
</style>
