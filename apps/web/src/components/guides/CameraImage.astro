---
import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import type {CameraItem} from '../../data/guide01CameraData';
interface Props {camera:CameraItem}
const {camera}=Astro.props;
// Every listed model requires a real local product photo. Missing assets fail the build.
const photo=readFileSync(new URL('../../../public'+camera.image,import.meta.url));
const version=createHash('sha256').update(photo).digest('hex').slice(0,12);
const src=`${camera.image}?v=${version}`;
---
<div class="cg-product-image" data-product-image>
 <img src={src} alt={`${camera.depictedModel||camera.name} 产品照片`} width="800" height="600" loading="lazy" decoding="async" data-camera-image data-photo-src={src}/>
 <div class="cg-product-error" data-product-error hidden role="status">
  <span>照片暂未加载</span>
  <button type="button" data-image-retry aria-label={`重新加载 ${camera.name} 的照片`}>重新加载照片</button>
 </div>
 {camera.depictedModel&&<small class="cg-photo-model">图示：{camera.depictedModel}</small>}
</div>
