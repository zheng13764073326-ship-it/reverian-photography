---
interface Props {home?:boolean;demo?:boolean}
const {home=false,demo=false}=Astro.props;
---
<footer class="site-footer container">
  <span class="footer-copyright">© {new Date().getFullYear()} REVERIAN · PHOTOGRAPHY</span>
  <span class="footer-motto">{demo?'演示版 · 照片、地点与文字为占位内容':'按下快门，因为热爱'}</span>
  <nav class="footer-links" aria-label="页脚导航">
    {!home&&<a href="/">回到首页 <span aria-hidden="true">↗</span></a>}
    <a href="#top" class="back-to-top" data-back-to-top aria-label="回到顶部" title="回到顶部"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20V4M4 12l8-8 8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </nav>
</footer>
<script>
  const topLink=document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  let resetTop:number|undefined;
  topLink?.addEventListener('click',event=>{
    if(event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
    event.preventDefault();
    window.clearTimeout(resetTop);
    topLink.classList.add('is-activated');
    resetTop=window.setTimeout(()=>topLink.classList.remove('is-activated'),900);
    document.querySelector<HTMLElement>('.site-header .brand')?.focus({preventScroll:true});
    window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });
  const fontTargets=document.querySelectorAll('.home-about,.social-section');
  let fontLoad:Promise<void>|undefined;
  const loadFonts=()=>fontLoad??=import('../lib/footer-font').then(module=>module.loadFooterSerif()).then(()=>{document.documentElement.dataset.footerFonts='ready';}).catch(()=>{document.documentElement.dataset.footerFonts='fallback';});
  if('IntersectionObserver' in window){
    const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){observer.disconnect();void loadFonts();}},{rootMargin:'300px'});
    fontTargets.forEach(target=>observer.observe(target));
  }else if(fontTargets.length){void loadFonts();}
</script>
<style>
 .site-footer{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:12px 28px;border-top:1px solid var(--line);padding:20px 0 24px;margin-top:36px;color:#4A4A4A;font:400 13px/1.6 var(--sans);letter-spacing:.025em}
 .footer-copyright{white-space:nowrap}
 .footer-links{display:flex;align-items:center;justify-content:flex-end;gap:24px}
 .footer-links a{display:inline-flex;align-items:baseline;gap:5px;min-height:44px;padding-block:12px;border:0;white-space:nowrap}
 .footer-links .back-to-top{--press-scale:.95;position:relative;display:grid;place-items:center;align-self:center;width:56px;height:56px;min-height:56px;padding:0;border:1px solid rgba(34,34,34,.28);border-radius:50%;color:#4A4A4A;background:transparent;text-decoration:none}
 .back-to-top svg{display:block}
 .footer-links .back-to-top:is(:active,[data-pressing],.is-activated){background-color:#BFA462;border-color:#BFA462;color:#111111}
 .footer-links a:focus-visible{outline:2px solid #1E4D54;outline-offset:4px}
 @media(hover:hover){.footer-links a:not(.back-to-top):hover{color:#1E4D54;text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}.footer-links .back-to-top:hover:not(:active):not([data-pressing]):not(.is-activated){border-color:#4A4A4A}}
 @media(max-width:760px){.site-footer{grid-template-columns:minmax(0,1fr) auto;gap:0 12px;padding:20px 0}.footer-copyright{grid-column:1/-1}.footer-links{gap:16px;align-items:center}}
 @media(max-width:360px){.site-footer{letter-spacing:0}.footer-links{gap:12px}}
</style>
