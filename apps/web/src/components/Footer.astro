---
interface Props {demo?:boolean}
const {demo=false}=Astro.props;
---
<footer class="site-footer container">
  <div class="footer-signature">
    {demo&&<span class="footer-demo">演示版 · 照片、地点与文字为占位内容</span>}
    <span class="footer-motto">Per aspera ad astra.</span>
    <span class="footer-copyright">© {new Date().getFullYear()} REVERIAN · PHOTOGRAPHY</span>
  </div>
  <nav class="footer-links" aria-label="页脚导航">
    <a href="#top" class="back-to-top" data-elastic-button data-elastic-gold data-back-to-top aria-label="回到顶部" title="回到顶部"><span class="elastic-button-face"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20V4M4 12l8-8 8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
  </nav>
</footer>
<script>
  const topLink=document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  let resetTop:number|undefined;
  topLink?.addEventListener('click',event=>{
    if(event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
    event.preventDefault();
    window.clearTimeout(resetTop);
    topLink.classList.add('is-activated');
    resetTop=window.setTimeout(()=>topLink.classList.remove('is-activated'),900);
    document.querySelector<HTMLElement>('.site-header .brand')?.focus({preventScroll:true});
    window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });
</script>
<style>
 .site-footer{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:16px 28px;border-top:1px solid var(--line);padding:20px 0 24px;margin-top:36px;color:#4A4A4A;font:400 13px/1.6 var(--sans);letter-spacing:.025em}
 .footer-signature{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0}
 .footer-motto{color:#7b786f;font:italic 400 20px/1.4 var(--serif);letter-spacing:.015em}
 .footer-copyright{font-style:normal;font-weight:400;white-space:nowrap}
 .footer-demo{color:var(--muted);font-size:12px}
 .footer-links{display:flex;align-items:flex-end;justify-content:flex-end}
 .footer-links .back-to-top{--press-scale:.95;position:relative;display:grid;place-items:center;width:56px;height:56px;min-height:56px;padding:0;border:0;border-radius:50%;color:#4A4A4A;background:transparent;text-decoration:none}
 .back-to-top .elastic-button-face{width:100%;height:100%;border:1px solid var(--elastic-face-border,rgba(34,34,34,.28));box-sizing:border-box}
 .back-to-top svg{display:block}
 .footer-links .back-to-top.is-activated .elastic-button-face{background-color:#BFA462;border-color:#BFA462;color:#111111}
 .footer-links a:focus-visible{outline:2px solid #1E4D54;outline-offset:4px}
 @media(hover:hover){.footer-links .back-to-top:hover:not(:active):not([data-pressing]):not(.is-activated) .elastic-button-face{border-color:var(--elastic-face-border,#4A4A4A)}}
 @media(max-width:760px){.site-footer{column-gap:16px;padding:20px 0}}
 @media(max-width:480px){.site-footer{column-gap:12px}.footer-motto{font-size:18px}.footer-copyright{font-size:11px;letter-spacing:0}}
</style>
