---
import type {Photo,Cover} from '../lib/types';
import {imageUrl,imageSet} from '../lib/images';
interface Props {photo:Photo;cover?:Pick<Cover,'focusX'|'focusY'>;ratio?:number;fit?:"cover"|"contain";eager?:boolean;sizes?:string;lightbox?:boolean;caption?:boolean;showInfo?:boolean;lightboxCaption?:string;group?:string}
const {photo,cover,ratio,fit="cover",eager=false,sizes='(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) 46vw, 560px',lightbox=true,caption=true,showInfo=true,lightboxCaption,group='photos'}=Astro.props;
const sourceRatio=fit==='contain'?undefined:ratio;
const style=`background: #e6e1d7${fit==='cover'?` url('${photo.image.lqip||''}') center/cover`:''};${ratio?`aspect-ratio:${ratio};`:''}`;
const innerStyle=(cover?`object-position:${cover.focusX*100}% ${cover.focusY*100}%;`:'')+(fit==='contain'?'object-fit:contain;transform:none;':'')||undefined;
---
<figure class:list={['photograph',{'cover-photo':!!ratio}]}>
 {lightbox ? <a class="image-frame" style={style} href={imageUrl(photo,2400)} data-lightbox data-group={group} data-title={showInfo?photo.title:''} data-alt={photo.alt} data-caption={lightboxCaption??(showInfo?[photo.caption,photo.location?.city,photo.takenAt].filter(Boolean).join(' · '):'')} aria-label={`放大查看：${showInfo?photo.title:photo.alt}`}>
  <img src={imageUrl(photo,1200,cover,sourceRatio)} srcset={imageSet(photo,cover,sourceRatio)} sizes={sizes} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async" style={innerStyle}/>
 </a> : <span class="image-frame" style={style}><img src={imageUrl(photo,1200,cover,sourceRatio)} srcset={imageSet(photo,cover,sourceRatio)} sizes={sizes} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading={eager?'eager':'lazy'} decoding="async" style={innerStyle}/></span>}
 {caption && <figcaption><span>{photo.title}</span><span>{photo.takenAt?.slice(0,4)}</span></figcaption>}
</figure>
