---
import type {Photo,Cover} from '../lib/types';
import {imageUrl,imageSet} from '../lib/images';
interface Props {storyMark?:boolean;photo:Photo;cover?:Pick<Cover,'focusX'|'focusY'>;ratio?:number;fit?:"cover"|"contain";eager?:boolean;sizes?:string;lightbox?:boolean;caption?:boolean;showInfo?:boolean;lightboxCaption?:string;group?:string}
const {storyMark=false,photo,cover,ratio,fit="cover",eager=false,sizes='(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) 46vw, 560px',lightbox=true,caption=true,showInfo=true,lightboxCaption,group='photos'}=Astro.props;
const story=(lightboxCaption??photo.caption)?.trim()||'';
// Older captions can be location credits alone, rather than a shooting note.
const hasStory=storyMark && Boolean(story) && !/^拍摄于[^。！？!?\r\n]+[。.]?$/.test(story);
const sourceRatio=fit==='contain'?undefined:ratio;
const style=`background: #e6e1d7${fit==='cover'?` url('${photo.image.lqip||''}') center/cover`:''};${ratio?`aspect-ratio:${ratio};`:''}`;
const innerStyle=(cover?`object-position:${cover.focusX*100}% ${cover.focusY*100}%;`:'')+(fit==='contain'?'object-fit:contain;transform:none;':'')||undefined;
---
<figure class:list={['photograph',{'cover-photo':!!ratio}]}>
 {lightbox ? <a class="image-frame" style={style} href={imageUrl(photo,2400)} data-lightbox data-fallback-src={imageUrl(photo,1200)} data-group={group} data-title={showInfo?photo.title:''} data-alt={photo.alt} data-caption={lightboxCaption??(showInfo?[photo.caption,photo.location?.city,photo.takenAt].filter(Boolean).join(' · '):'')} aria-label={`放大查看：${showInfo?photo.title:photo.alt}${hasStory?'；附拍摄手记，点开阅读':''}`}>
  <img data-fallback-src={imageUrl(photo,800,cover,sourceRatio)} src={imageUrl(photo,1200,cover,sourceRatio)} srcset={imageSet(photo,cover,sourceRatio)} sizes={sizes} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async" style={innerStyle}/>
  {hasStory&&<span class="photo-story-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3c.8 5.5 3.5 8.2 9 9-5.5.8-8.2 3.5-9 9-.8-5.5-3.5-8.2-9-9 5.5-.8 8.2-3.5 9-9Z" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg><span>手记</span></span>}
 </a> : <span class="image-frame" style={style}><img data-fallback-src={imageUrl(photo,800,cover,sourceRatio)} src={imageUrl(photo,1200,cover,sourceRatio)} srcset={imageSet(photo,cover,sourceRatio)} sizes={sizes} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading={eager?'eager':'lazy'} decoding="async" style={innerStyle}/></span>}
 {caption && <figcaption><span>{photo.title}</span><span>{photo.takenAt?.slice(0,4)}</span></figcaption>}
</figure>

<style>
 .image-frame{position:relative}
 .photo-story-mark{position:absolute;right:18px;bottom:18px;display:inline-flex;align-items:center;gap:7px;padding:7px 11px 7px 8px;border:1px solid rgba(218,196,154,.65);border-radius:999px;background:rgba(30,29,24,.78);color:#ead8b7;box-shadow:0 2px 10px rgba(0,0,0,.12);font-family:var(--serif-zh);font-size:11px;line-height:1;letter-spacing:.14em;pointer-events:none;transition:background .2s,border-color .2s}
 .photo-story-mark svg{width:20px;height:20px;flex-shrink:0}
 .image-frame:hover .photo-story-mark,.image-frame:focus-visible .photo-story-mark{background:rgba(30,29,24,.94);border-color:#ead8b7}
 @media(max-width:600px){.photo-story-mark{right:10px;bottom:10px;padding:5px 8px 5px 6px;gap:5px;font-size:10px}.photo-story-mark svg{width:18px;height:18px}}
 @media(prefers-reduced-motion:reduce){.photo-story-mark{transition:none}}
</style>
