<dialog id="lightbox" aria-label="照片全屏浏览">
 <header><span id="viewer-title"></span><button id="viewer-close" autofocus aria-label="关闭大图">关闭 ×</button></header>
 <button id="viewer-prev" aria-label="上一张照片">←</button><img id="viewer-image" alt=""/><button id="viewer-next" aria-label="下一张照片">→</button>
 <footer><span id="viewer-info"></span><span id="viewer-count" aria-live="polite"></span></footer>
</dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#lightbox')!;
const image=document.querySelector<HTMLImageElement>('#viewer-image')!;
const title=document.querySelector('#viewer-title')!,info=document.querySelector('#viewer-info')!,count=document.querySelector('#viewer-count')!;
let links:HTMLAnchorElement[]=[],index=0,returnFocus:HTMLElement|null=null,overflow='';
const close=document.querySelector<HTMLButtonElement>('#viewer-close')!;
const footer=dialog.querySelector('footer')!;
// Reserve the actual caption height so longer stories stay below the photograph.
new ResizeObserver(()=>{
 if(!dialog.open)return;
 const bottom=parseFloat(getComputedStyle(footer).bottom)||0;
 dialog.style.setProperty('--viewer-footer-space',`${Math.ceil(footer.getBoundingClientRect().height+bottom+24)}px`);
}).observe(footer);
function showCaption(caption:string){
 const paragraphs=/\r?\n\s*\r?\n/.test(caption);
 info.toggleAttribute('data-paragraphs',paragraphs);
 if(paragraphs)info.setAttribute('tabindex','0');else info.removeAttribute('tabindex');
 // A closed dialog has no layout; reset after it becomes visible.
 requestAnimationFrame(()=>{info.scrollTop=0;});

 // A leading bold heading is plain text plus one strong element; never inject HTML.
 const heading=caption.match(/^\*\*([^\r\n]+?)\*\*\r?\n/);
 if(!heading){info.textContent=caption;return;}
 const label=document.createElement('strong');label.textContent=heading[1];
 info.replaceChildren(label,document.createElement('br'),document.createTextNode(caption.slice(heading[0].length)));
}
function update(){const a=links[index];image.src=a.getAttribute('href')!;image.alt=a.dataset.alt||a.dataset.title||'';title.textContent=a.dataset.title||'';showCaption(a.dataset.caption||'');count.textContent=`${index+1} / ${links.length}`;}
function step(delta:number){index=(index+delta+links.length)%links.length;update();}
document.addEventListener('click',event=>{
 const link=(event.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
 if(!link)return;
 event.preventDefault();links=[...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')].filter(a=>a.dataset.group===link.dataset.group);index=links.indexOf(link);returnFocus=link;update();overflow=document.body.style.overflow;document.body.style.overflow='hidden';dialog.showModal();close.focus();
});
close.addEventListener('click',()=>dialog.close());
dialog.addEventListener('close',()=>{document.body.style.overflow=overflow;image.removeAttribute('src');returnFocus?.focus({preventScroll:true});});
document.querySelector('#viewer-prev')!.addEventListener('click',()=>step(-1));document.querySelector('#viewer-next')!.addEventListener('click',()=>step(1));
dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
dialog.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'){event.preventDefault();step(-1);}if(event.key==='ArrowRight'){event.preventDefault();step(1);}});
let start:{x:number;y:number}|null=null;
image.addEventListener('touchstart',event=>{start=event.touches.length===1?{x:event.touches[0].clientX,y:event.touches[0].clientY}:null;},{passive:true});
image.addEventListener('touchend',event=>{if(!start)return;const t=event.changedTouches[0],dx=t.clientX-start.x,dy=t.clientY-start.y;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.3)step(dx<0?1:-1);start=null;},{passive:true});
</script>
