---
import entries from '../data/lab/prompts.json';
import {sortPrompts,recentPrompts,promptTimestamp,RECENT_PROMPT_DAYS,PROMPT_SEARCH_THRESHOLD} from '../lib/ai-prompt-catalog';
const creations=sortPrompts(entries);
const recent=new Set(recentPrompts(creations));
const categories=[['all','全部'],['objects','周边物件'],['paper','平面设计'],['worlds','游戏电影'],['forms','艺术画风']];
const sections=(prompt:string)=>prompt.split('\n').filter(Boolean).map(line=>{const colon=line.indexOf('：');return {title:line.slice(0,colon),text:line.slice(colon+1)};});
---
<h2 id="lab-section-ai" class="lab-sr-only">AI 提示词库作品</h2>
<div class="lab-filter-toolbar">
<div class="lab-use-filters" role="group" aria-label="创作类型筛选">
  {categories.map(([id,label])=><button type="button" data-prompt-filter={id} aria-pressed={id==='all'?'true':'false'} aria-controls="lab-prompt-grid">{label}</button>)}
</div>
<button type="button" class="lab-search-toggle" data-prompt-search-toggle hidden={creations.length<PROMPT_SEARCH_THRESHOLD} aria-label="搜索提示词" aria-expanded="false" aria-controls="lab-prompt-search-panel"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5"/></svg></button>
</div>
<div class="lab-prompt-search-panel" id="lab-prompt-search-panel" data-prompt-search-panel hidden>
 <label for="lab-prompt-search" class="lab-sr-only">按标题或关键词搜索提示词</label>
 <input id="lab-prompt-search" data-prompt-search type="search" placeholder="搜索邮票、水彩、胶片…" maxlength="100" autocomplete="off" aria-controls="lab-prompt-grid"/>
 <button type="button" data-prompt-search-clear>清空</button>
</div>
<p class="lab-prompt-empty" data-prompt-empty hidden role="status">没有找到匹配的提示词。<button type="button" data-prompt-reset>查看全部</button></p>
<output class="lab-sr-only" data-prompt-count aria-live="polite">{creations.length} 组创作</output>
<div class="lab-prompt-grid" id="lab-prompt-grid">
  {creations.map(work=><article class="lab-prompt-card" id={work.id} data-prompt-category={work.category} data-prompt-search-text={[work.title,work.description,work.categoryLabel,...work.keywords].join(' ')} aria-labelledby={`${work.id}-title`}>
    <div class="lab-creation-card-body">
      <div class="lab-art-stage" style={`aspect-ratio:${work.artwork.width}/${work.artwork.height}`} aria-label={`${work.title}原片对照`}>
        {(['artwork','original'] as const).map(kind=>{
          const image=work[kind],active=kind==='artwork',label=active?'成品':'原片';
          return <a class="lab-art-link" id={`${work.id}-${kind}`} data-creation-image={kind} data-active={String(active)} aria-hidden={active?undefined:'true'} inert={!active} tabindex={active?0:-1} href={image.src} data-lightbox data-group={`study-${work.id}`} data-title={`${label} · ${active?work.title:work.original.title}`} data-alt={image.alt} data-caption={active?work.description:work.sourceLabel} data-photo-width={image.width} data-photo-height={image.height} data-fallback-src={image.preview} aria-label={`放大${label}：${work.title}`}>
            <img src={image.preview} srcset={image.srcset} sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1199px) calc((100vw - 112px) / 2), (max-width: 1280px) calc((100vw - 128px) / 3), 384px" alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async"/>
          </a>;
        })}
        <div class="lab-art-switch" role="group" aria-label={`${work.title}显示版本`}>
          <button type="button" data-creation-view="artwork" aria-pressed="true" aria-controls={`${work.id}-artwork`}>成品</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-creation-view="original" aria-pressed="false" aria-controls={`${work.id}-original`}>原片</button>
        </div>
        <span class="lab-art-status" role="status" hidden></span>
      </div>
      <div class="lab-creation-notes">
        <h3 id={`${work.id}-title`}><span>{work.index}</span>{work.title}{recent.has(work.id)&&<span class="lab-prompt-new" data-new-until={promptTimestamp(work)+RECENT_PROMPT_DAYS*86400000} aria-label="最近更新"><i aria-hidden="true"></i>NEW</span>}</h3>
        <p>{work.description}</p>
        <div class="lab-creation-actions">
          <a class="lab-creation-origin" href={work.sourceHref}>原片：{work.sourceLabel}<span aria-hidden="true"> ↗</span></a>
          <button type="button" class="lab-prompt-open" data-open-prompt={work.id} aria-haspopup="dialog" aria-controls="lab-prompt-drawer" aria-label={`查看${work.title}提示词`}>提示词</button>
        </div>
      </div>
    </div>
    <template data-prompt-template={work.id} data-title={`${work.index} ${work.title}`} data-prompt={work.prompt}>
      <div class="lab-prompt-meta">
        <dl><div><dt>操作方式</dt><dd>{work.usage.mode}</dd></div><div><dt>建议比例</dt><dd>{work.usage.ratio}</dd></div><div class="lab-prompt-models"><dt>适用模型</dt><dd>{work.usage.models}</dd></div></dl>
        <p>{work.usage.note}</p>
      </div>
      <div data-prompt-text>{sections(work.prompt).map(section=><section><h3>{section.title}</h3><p>{section.text}</p></section>)}</div>
    </template>
  </article>)}
</div>
<dialog id="lab-prompt-drawer" class="lab-prompt-drawer" aria-labelledby="lab-prompt-title">
  <header>
    <div class="lab-prompt-heading"><h2 id="lab-prompt-title"></h2><button type="button" class="lab-prompt-close" data-prompt-close aria-label="关闭提示词">×</button></div>
    <button type="button" class="lab-prompt-copy" data-copy-prompt autofocus>一键复制提示词</button>
    <p class="lab-prompt-status" role="status" aria-live="polite"></p>
  </header>
  <div class="lab-prompt-scroll" data-prompt-body tabindex="0" aria-label="完整提示词"></div>
</dialog>
