---
interface Props {home?:boolean}
const {home=false}=Astro.props;
const path=Astro.url.pathname;
const portfolios=[['/works/','精选作品'],['/albums/','光影存档'],['/wild/','万物生灵'],['/above/','云端视角'],['/film/','胶片来信']];
---
<header class:list={['site-header',{'home-header':home,'over-cover':home}]} id="site-header">
 <a class="brand" href="/" aria-label="挽风 | Reverian Photography 首页">{home?<svg class="brand-signature" viewBox="498 840 984 407" role="img" aria-label="挽风"><image href="/images/branding/wanfeng-white.webp" width="2000" height="2000"/></svg>:<><strong>PHOTOGRAPHY</strong><small>CURATED SEQUENCE</small></>}</a>
 <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="打开导航"><span></span><span></span><span></span></button>
 <nav id="main-nav" aria-label="主导航">
  <a href="/" aria-current={path==='/'?'page':undefined}>首页</a>
  <details class="portfolio-nav"><summary>作品集 <span aria-hidden="true">⌄</span></summary><div class="portfolio-panel">
   {portfolios.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}
  </div></details>
  <details class="portfolio-nav lab-nav"><summary aria-current={path.startsWith('/lab/')?'true':undefined}>光学实验室 <span aria-hidden="true">⌄</span></summary><div class="portfolio-panel">
   <a href="/lab/" data-lab-link="guides">摄影入门</a>
   <a href="/lab/ai-prompts/" data-lab-link="ai">AI 提示词库</a>
   <a href="/lab/?tab=sunset" data-lab-link="sunset">火烧云</a>
   <a href="/lab/?tab=critique" data-lab-link="critique" data-lab-label="AI 评片">AI 评片</a>
  </div></details>
  <a href="/essays/" aria-current={path.startsWith('/essays/')?'page':undefined}>随笔</a>
  <a href="/about/" aria-current={path==='/about/'?'page':undefined}>关于我</a>
 </nav>
</header>
<script>
const header=document.querySelector<HTMLElement>('.site-header')!;
const toggle=header.querySelector<HTMLButtonElement>('.menu-toggle')!;
const nav=header.querySelector<HTMLElement>('nav')!;
const main=document.querySelector<HTMLElement>('main')!;
const dropdowns=[...header.querySelectorAll<HTMLDetailsElement>('details')];
const closeDropdowns=()=>dropdowns.forEach(details=>{details.open=false;});
const media=matchMedia('(max-width: 800px)');
let previousOverflow='';
function setMenu(open:boolean){
 const wasOpen=toggle.getAttribute('aria-expanded')==='true';
 toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'关闭导航':'打开导航');header.classList.toggle('menu-open',open);
 main.inert=open;
 if(open&&!wasOpen){previousOverflow=document.body.style.overflow;document.body.style.overflow='hidden';}
 if(!open&&wasOpen)document.body.style.overflow=previousOverflow;
 nav.inert=media.matches&&!open;
}
toggle.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));
media.addEventListener('change',()=>{setMenu(false);closeDropdowns();});
nav.inert=media.matches;
dropdowns.forEach(details=>details.addEventListener('toggle',()=>{
 if(details.open)dropdowns.forEach(other=>{if(other!==details)other.open=false;});
}));
nav.addEventListener('click',event=>{
 if(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
 if((event.target as Element).closest('a[href]')){setMenu(false);closeDropdowns();}
});
document.addEventListener('click',event=>{if(!header.contains(event.target as Node))closeDropdowns();});
document.addEventListener('keydown',event=>{
 if(event.key==='Escape'){
  const opened=toggle.getAttribute('aria-expanded')==='true';
  const active=dropdowns.find(details=>details.open&&details.contains(document.activeElement));
  setMenu(false);closeDropdowns();
  if(opened)toggle.focus();else active?.querySelector('summary')?.focus();
 }
 if(event.key==='Tab'&&toggle.getAttribute('aria-expanded')==='true'){
  const focusable=[...header.querySelectorAll<HTMLElement>('a,button,summary')].filter(el=>el.getClientRects().length);
  const first=focusable[0],last=focusable.at(-1)!;
  if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}
  else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}
 }
});
const hero=document.querySelector('.home-cover');
if(hero)new IntersectionObserver(([entry])=>header.classList.toggle('over-cover',entry.isIntersecting),{rootMargin:'-80px 0px 0px 0px',threshold:0}).observe(hero);
// Preserve the shared prototype links when moving to real page URLs.
const legacy:Record<string,string>={'#/home':'/','#/selected':'/works/','#/collections':'/albums/','#/street':'/works/','#/wild':'/wild/','#/above':'/above/','#/film':'/film/','#/about':'/about/','#/lab':'/lab/'};
if(location.hash in legacy)location.replace(legacy[location.hash]);
</script>

<style>
 @media(min-width:801px) and (max-width:1100px){.site-header nav{gap:clamp(18px,2.5vw,30px);font-size:20px;letter-spacing:1px}}
 /* Homepage typography is deliberately scoped; internal reading pages keep their navigation. */
 @media(min-width:801px){
  .site-header.home-header nav{font-family:var(--sans);font-size:14px;letter-spacing:.06em;gap:clamp(24px,3vw,44px)}
  .site-header.home-header .portfolio-panel a{font-family:var(--sans);font-size:14px;line-height:1.8}
 }
</style>
