<div class="focus-cursor" aria-hidden="true">
 <span class="pointer-frame"><i></i><i></i><i></i><i></i></span>
 <span class="pointer-center"></span>
</div>
<script>
 import {setupElasticButtons} from '../lib/elastic-buttons';
 import '../styles/elastic-buttons.css';
 import {setupSurfaceFeedback} from '../lib/surface-feedback';
 import '../styles/surface-feedback.css';
 setupSurfaceFeedback();
 setupElasticButtons();
 const ring=document.querySelector<HTMLElement>('.focus-cursor')!;
 const enabled=matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
 let x=0,y=0,frame=0,visible=false;
 function hide(){if(frame)cancelAnimationFrame(frame);frame=0;visible=false;document.documentElement.classList.remove('pointer-ready');ring.classList.remove('is-visible','is-pressed');}
 function paint(){
  frame=0;
  const target=document.elementFromPoint(x,y);
  if(!enabled.matches||!target||target.closest('dialog[open],input,textarea,select,[contenteditable="true"]')){hide();return;}
  const link=target.closest('a,button,summary,[role="button"]');
  const photo=target.closest('a[data-lightbox]');
  const album=target.closest('.album-card a,.next-story,.drift-card');
  const imageSurface=target.closest('.editorial-cover,.album-card,.photograph,.next-story,.reel-frame,.drift-photo-link,.optical-photo-frame');
  ring.dataset.surface=imageSurface?'image':'paper';
  ring.dataset.kind=photo||album?'photo':link?'link':'idle';
  ring.style.transform=`translate3d(${x}px,${y}px,0) translate(-50%,-50%)`;
  ring.classList.add('is-visible');document.documentElement.classList.add('pointer-ready');visible=true;
 }
 function schedule(){if(!frame)frame=requestAnimationFrame(paint);}
 document.addEventListener('pointermove',event=>{
  if(event.pointerType!=='mouse'){hide();return;}
  x=event.clientX;y=event.clientY;schedule();
 },{passive:true});
 document.addEventListener('scroll',()=>{if(visible)schedule();},{passive:true,capture:true});
 document.addEventListener('pointerleave',hide);
 document.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse'){hide();return;}if(visible&&event.button===0)ring.classList.add('is-pressed');},{passive:true});
 document.addEventListener('pointerup',()=>ring.classList.remove('is-pressed'),{passive:true});
 document.addEventListener('pointercancel',hide,{passive:true});
 document.addEventListener('keydown',event=>{if(event.key==='Tab'||event.key==='Escape')hide();});
 window.addEventListener('blur',hide);
 document.addEventListener('visibilitychange',()=>{if(document.hidden)hide();});
 enabled.addEventListener('change',hide);

 // Hold touch feedback until release; scrolling cancels it without blocking gestures.
 let pressed:HTMLElement|null=null,pressX=0,pressY=0;
 const releasePress=()=>{pressed?.removeAttribute('data-pressing');pressed=null;};
 document.addEventListener('pointerdown',event=>{
  if(event.pointerType==='mouse')return;
  releasePress();
  const target=event.target instanceof Element?event.target.closest<HTMLElement>('a,button,summary'):null;
  if(!target||target.matches(':disabled,[aria-disabled="true"]')||target.closest('[inert]'))return;
  pressed=target;pressX=event.clientX;pressY=event.clientY;
  pressed.setAttribute('data-pressing','');
 },{passive:true});
 document.addEventListener('pointermove',event=>{if(pressed&&Math.hypot(event.clientX-pressX,event.clientY-pressY)>8)releasePress();},{passive:true});
 window.addEventListener('pointerup',releasePress,{passive:true});
 window.addEventListener('pointercancel',releasePress,{passive:true});
 window.addEventListener('blur',releasePress);
 window.addEventListener('pagehide',releasePress);
 document.addEventListener('contextmenu',releasePress);
 document.addEventListener('visibilitychange',()=>{if(document.hidden)releasePress();});
</script>
<style is:global>
 .focus-cursor{--frame-size:40px;--corner-size:9px;display:none;position:fixed;top:0;left:0;z-index:1000;width:var(--frame-size);height:var(--frame-size);color:#a58a4b;pointer-events:none;opacity:0;transition:width .22s ease,height .22s ease,opacity .15s ease,color .2s ease;will-change:transform}
 .focus-cursor[data-surface="image"]{color:#c6aa65;filter:drop-shadow(0 1px 1px #171a1326)}
 .pointer-frame{position:absolute;inset:0;transform-origin:center;transition:transform .18s cubic-bezier(.2,.7,.2,1)}
 .pointer-frame i{position:absolute;display:block;width:var(--corner-size);height:var(--corner-size);border:0 solid currentColor;transition:width .22s ease,height .22s ease}
 .pointer-frame i:nth-child(1){top:0;left:0;border-width:1.5px 0 0 1.5px}
 .pointer-frame i:nth-child(2){top:0;right:0;border-width:1.5px 1.5px 0 0}
 .pointer-frame i:nth-child(3){bottom:0;left:0;border-width:0 0 1.5px 1.5px}
 .pointer-frame i:nth-child(4){bottom:0;right:0;border-width:0 1.5px 1.5px 0}
 .pointer-center{position:absolute;left:50%;top:50%;width:4px;height:4px;border-radius:50%;background:currentColor;transform:translate(-50%,-50%);transition:transform .18s ease}
 .focus-cursor.is-pressed .pointer-frame{transform:scale(.83)}
 .focus-cursor.is-pressed .pointer-center{transform:translate(-50%,-50%) scale(.8)}
 @media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){
  .focus-cursor{display:block}
  .focus-cursor.is-visible{opacity:1}
  .focus-cursor[data-kind="link"]{--frame-size:28px;--corner-size:7px}
  .focus-cursor[data-kind="photo"]{--frame-size:46px;--corner-size:10px}
  html.pointer-ready,html.pointer-ready *{cursor:none!important}
  html.pointer-ready:has(dialog[open]),html.pointer-ready:has(dialog[open]) *{cursor:auto!important}
  html.pointer-ready:has(dialog[open]) .focus-cursor{opacity:0}
  .site-header nav>a,.portfolio-nav summary,.portfolio-panel a,.section-heading h2 a,.section-heading>a,.text-link,.back-link,.album-topline>a,.return-stories>span:last-child{display:inline-block;transform-origin:left center;transition:transform .22s ease,color .22s ease}
  .site-header nav>a:hover,.portfolio-nav summary:hover,.portfolio-panel a:hover,.section-heading h2 a:hover,.section-heading>a:hover,.text-link:hover,.back-link:hover,.album-topline>a:hover,.return-stories:hover>span:last-child{transform:scale(1.045)}
  .album-meta h3,.journal-row h3{transform-origin:left center;transition:transform .25s ease}
  .album-card a:hover h3,.journal-row:hover h3{transform:scale(1.025)}
  .album-card img,.photograph a img,.next-story img,.reel-frame img,.drift-photo-link img{transition:transform .5s ease}
  .photograph a:hover img,.reel-frame:hover img,.drift-photo-link:hover img{transform:scale(1.018);animation:photo-exposure .48s ease-out 1}
 }
 @keyframes photo-exposure{0%,100%{filter:var(--photo-optics-filter, brightness(1)) brightness(1)}40%{filter:var(--photo-optics-filter, brightness(1)) brightness(var(--photo-exposure-peak, 1.12))}}
 .section-heading a:focus-visible,.album-card a:focus-visible,.photograph a:focus-visible,.journal-row:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
</style>
