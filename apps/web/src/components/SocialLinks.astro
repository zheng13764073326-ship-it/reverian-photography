---
import type {Settings} from '../lib/types';
interface Props {links: Settings['socialLinks'];compact?:boolean;id?:string}
const {links,compact=false,id='social-title'}=Astro.props;
---
{links.length>0&&<section class:list={['social-section',{'social-compact':compact}]} aria-labelledby={id}>{compact?<h3 id={id}>CONNECT // 联络</h3>:<h2 id={id}>CONNECT // 联络</h2>}<div class="social-buttons">{links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label}（新窗口打开）`}>
 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">{link.label.toLowerCase().includes('instagram')?<><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"/></>:/抖音|douyin|tiktok/i.test(link.label)?<path d="M14 3h3c.5 2.4 2 3.8 4 4v3a10 10 0 0 1-4-1v7a5 5 0 1 1-5-5v3a2 2 0 1 0 2 2V3Z" stroke-linejoin="round"/>:<><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Z"/><path d="M12 5v15"/></>}</svg><span class="social-name">{link.label}</span><span class="social-arrow" aria-hidden="true">↗</span>
 </a>)}</div></section>}
<style>
 .social-section{text-align:center;margin:40px 0 36px}
 .social-section h2,.social-section h3{font:400 11px/1.5 'Courier New',var(--sans),monospace;letter-spacing:.14em;color:rgba(34,34,34,.45);margin:0 0 8px}
 .social-buttons{display:flex;flex-wrap:wrap;justify-content:center;column-gap:28px;row-gap:0}
 .social-buttons a{display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:0;border:0;border-radius:0;background:transparent;color:#54564e;font:400 13px/1.5 var(--sans);white-space:nowrap}
 .social-buttons svg{width:16px;height:16px;flex:none}
 .social-arrow{font-size:11px;opacity:.65}
 .social-buttons a:focus-visible{outline:2px solid #1E4D54;outline-offset:4px}
 @media(hover:hover){.social-buttons a:hover{color:#1E4D54}.social-buttons a:hover .social-name{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}}
 .social-compact{text-align:left;margin:24px 0 0}
 .social-compact .social-buttons{justify-content:flex-start}
</style>
