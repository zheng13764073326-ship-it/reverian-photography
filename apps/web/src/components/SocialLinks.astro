---
import type {Settings} from '../lib/types';
interface Props {links: Settings['socialLinks'];compact?:boolean;id?:string}
const {links,compact=false,id='social-title'}=Astro.props;
// Public display names requested for the directory; destinations stay in the CMS.
const displayName=(label:string)=>/instagram/i.test(label)?'@reverian':/小红书|抖音/i.test(label)?'@挽风':'';
---
{links.length>0&&<section class:list={['social-section',{'social-compact':compact}]} aria-labelledby={id}>
  {compact?<h3 id={id}>CONNECT // 联络</h3>:<h2 id={id}>CONNECT // 联络</h2>}
  <ol class="social-list" role="list">
    {links.map((link,index)=><li>
      <a class="social-row" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label}（新窗口打开）`}>
        <span class="social-label"><span class="social-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><span class="social-name">{link.label}</span></span>
        <span class="social-destination"><span class="social-handle">{displayName(link.label)}</span><span class="social-arrow" aria-hidden="true">↗</span></span>
      </a>
    </li>)}
  </ol>
</section>}
<style>
 .social-section{text-align:left;margin:40px 0 36px}
 .social-section h2,.social-section h3{font:400 13px/1.5 'Courier New','Noto Serif SC',monospace;letter-spacing:.14em;color:#555555;margin:0 0 12px}
 .social-list{list-style:none;padding:0;margin:0;border-top:1px solid rgba(34,34,34,.1)}
 .social-list li{border-bottom:1px solid rgba(34,34,34,.1)}
 .social-list li:last-child{border-bottom:0}
 .social-row{--press-scale:.99;display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;padding:16px 0;border:0;border-radius:0;background:transparent;color:#222222;font:400 16px/1.5 var(--sans);text-decoration:none}
 .social-label{display:flex;align-items:baseline;gap:14px;min-width:0}
 .social-number{flex:none;font:400 15px/1.5 'Courier New',monospace;color:#555555;transition:color .2s ease}
 .social-name{min-width:0;font:600 20px/1.5 'Noto Serif SC','Songti SC',Georgia,serif;color:#1A1A1A;font-synthesis:none;transition:color .2s ease}
 .social-destination{display:flex;align-items:center;gap:8px;flex:none;font:400 15px/1.5 'Courier New','Noto Serif SC',monospace;color:#555555;white-space:nowrap;transition:color .2s ease}
 .social-arrow{display:inline-block;transition:transform .35s var(--press-spring)}
 .social-row:focus-visible{outline:2px solid #1E4D54;outline-offset:3px}
 @media(hover:hover){.social-row:hover{background-color:rgba(34,34,34,.035);color:#1E4D54}.social-row:hover .social-name,.social-row:hover .social-number,.social-row:hover .social-destination{color:#1E4D54}.social-row:hover .social-arrow{transform:translate(3px,-3px)}}
 .social-compact{margin:24px 0 0}
</style>
