<script>
function setupScrollReveal(){
 const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
 if(motion.matches||!('IntersectionObserver' in window)||!Element.prototype.animate)return;

 // Animate editorial text, leaving photographs and interactive widgets in place.
 const selectors=[
  'main .section-heading',
  'main .prose > :is(p,h2,h3,h4,blockquote,ul,ol)',
  'main .photograph > figcaption',
  'main .album-meta',
  'main .album-location',
  'main .album-excerpt',
  'main .journal-row',
  'main .album-cover-note',
  'main .album-preface > .eyebrow',
  'main .album-colophon',
  'main .next-story > div',
  'main .about-rule',
  'main .about-note > :is(h2,p)',
  'main .about-copy > :is(h2,p)',
 ];
 const candidates=new Set(document.querySelectorAll<HTMLElement>(selectors.join(',')));
 const pending=new Set<HTMLElement>();
 const running=new Map<HTMLElement,Animation>();
 const reveal=(element:HTMLElement,delay=0,animate=true)=>{
  observer.unobserve(element);
  pending.delete(element);
  element.removeAttribute('data-scroll-reveal');
  if(!animate||motion.matches){running.get(element)?.cancel();return;}
  const animation=element.animate(
   [{opacity:0,translate:'0 22px'},{opacity:1,translate:'0 0'}],
   {duration:700,delay,easing:'cubic-bezier(.22,1,.36,1)',fill:'backwards'},
  );
  running.set(element,animation);
  const done=()=>running.delete(element);
  animation.addEventListener('finish',done,{once:true});
  animation.addEventListener('cancel',done,{once:true});
 };
 const observer=new IntersectionObserver(entries=>{
  entries.filter(entry=>entry.isIntersecting).forEach((entry,index)=>{
   reveal(entry.target as HTMLElement,Math.min(index,3)*60);
  });
 },{threshold:.12});

 for(const element of candidates){
  let parent=element.parentElement;
  while(parent&&!candidates.has(parent))parent=parent.parentElement;
  if(parent||element.closest('dialog,[hidden]')||!element.getClientRects().length)continue;
  // Keep everything already on screen readable immediately, including restored scroll positions.
  if(element.getBoundingClientRect().top<window.innerHeight)continue;
  pending.add(element);
  element.dataset.scrollReveal='pending';
  observer.observe(element);
 }
 document.addEventListener('focusin',event=>{
  const target=event.target;
  if(!(target instanceof Element))return;
  for(const element of [...pending,...running.keys()]){
   if(element.contains(target))reveal(element,0,false);
  }
 });
 motion.addEventListener('change',()=>{
  if(!motion.matches)return;
  observer.disconnect();
  for(const element of pending)element.removeAttribute('data-scroll-reveal');
  pending.clear();
  for(const animation of running.values())animation.cancel();
  running.clear();
 });
}
setupScrollReveal();
</script>
<style is:global>
 @media(prefers-reduced-motion:no-preference){
  [data-scroll-reveal="pending"]{opacity:0;translate:0 22px}
 }
 @media print{
  [data-scroll-reveal="pending"]{opacity:1!important;translate:none!important}
 }
</style>
