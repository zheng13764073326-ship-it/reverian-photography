---
import Photo from './Photo.astro';
import SocialLinks from './SocialLinks.astro';
import type {Settings} from '../lib/types';
interface Props {settings:Settings}
const {settings}=Astro.props;
const headingIndex=settings.about.findIndex(block=>block.style==='h2');
const heading=headingIndex>=0?settings.about[headingIndex].children.map(span=>span.text).join(''):'';
const firstParagraph=settings.about.slice(headingIndex>=0?headingIndex+1:0).find(block=>(!block.style||block.style==='normal')&&block.children?.some(span=>span.text));
const introduction=settings.introduction||firstParagraph?.children.map(span=>span.text).join('')||'';
---
<section id="about" class="container home-about" aria-labelledby="home-about-name">
  <div class="about-rule"><p class="eyebrow">ABOUT THE PHOTOGRAPHER</p><span aria-hidden="true">关于我</span></div>
  <div class:list={['about-spread',{'without-portrait':!settings.portrait}]}>
    {settings.portrait&&<a href="/about/?quiz=start#tacit" class="portrait-link" aria-label="测测我们的默契度，点击开始">
      <div class="portrait-stage">
        <Photo photo={settings.portrait.photo} caption={false} lightbox={false} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) 50vw, 640px"/>
        <span class="portrait-focus" aria-hidden="true"></span>
        <span class="portrait-invite" aria-hidden="true">测测我们的默契度<span>↗</span></span>
      </div>
      <span class="portrait-caption"><span class="quiz-label"><i class="quiz-dot" aria-hidden="true"></i>默契度</span><span class="quiz-caption-hint">十道题，看看你多懂我</span><span class="quiz-caption-arrow" aria-hidden="true">↗</span></span>
    </a>}
    <div class="about-note">
      <h2 id="home-about-name">{settings.photographer}</h2>
      {heading&&<p class="about-lead">{heading}</p>}
      {introduction&&<p class="about-excerpt">{introduction}</p>}
      <a class="about-link" href="/about/"><span>关于我</span><span class="about-arrow" aria-hidden="true">↗</span></a>
      {!settings.portrait&&<a class="quiz-fallback" href="/about/?quiz=start#tacit">测测我们的默契度 ↗</a>}
      <SocialLinks links={settings.socialLinks} compact id="home-social-title"/>
    </div>
  </div>
</section>
<style>
  .home-about{padding-block:32px 64px}
  .about-rule{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:22px;margin-bottom:38px;color:var(--muted)}
  .about-rule .eyebrow{margin:0;font-size:10px;letter-spacing:.22em}
  .about-rule>span{font:12px var(--serif-zh);letter-spacing:.16em;white-space:nowrap}
  .about-spread{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(32px,5vw,72px);align-items:center}
  .portrait-link{display:block;min-width:0;--quiz-blue:#237489}
  .portrait-stage{position:relative;display:block;isolation:isolate}
  .portrait-link :global(figure){margin:0}
  .portrait-link :global(img){width:100%;height:auto;display:block;transition:filter .3s}
  .portrait-link:focus-visible{outline:2px solid var(--quiz-blue);outline-offset:6px}
  .portrait-focus{position:absolute;inset:16px;border:1px solid #86c5d180;pointer-events:none;opacity:0;transition:opacity .25s}
  .portrait-focus::before,.portrait-focus::after{content:'';position:absolute;width:22px;height:22px;border-color:#9cdeeb;border-style:solid}
  .portrait-focus::before{top:-1px;left:-1px;border-width:2px 0 0 2px}
  .portrait-focus::after{right:-1px;bottom:-1px;border-width:0 2px 2px 0}
  .portrait-invite{position:absolute;top:50%;left:50%;transform:translate(-50%,calc(-50% + 8px));display:flex;align-items:center;gap:18px;white-space:nowrap;padding:14px 20px;border:1px solid #bfd2d3;border-radius:3px;background:#f4f1e9f5;color:var(--quiz-blue);font:17px var(--serif-zh);letter-spacing:.08em;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none}
  .portrait-caption{display:flex;align-items:center;gap:14px;padding-top:14px;font:11px/1.6 var(--sans);color:var(--muted)}
  .quiz-label{display:inline-flex;align-items:center;gap:8px;color:var(--quiz-blue);font-size:12px;letter-spacing:.14em}
  .quiz-dot{width:6px;height:6px;border-radius:50%;background:#328ea9;animation:quiz-beacon 2.4s ease-in-out infinite}
  .quiz-caption-arrow{margin-left:auto;font-size:17px;color:var(--quiz-blue)}
  .portrait-link:focus-visible .portrait-invite{opacity:1;transform:translate(-50%,-50%)}
  .portrait-link:focus-visible .portrait-focus{opacity:1}
  @media(hover:hover){.portrait-link:hover .portrait-invite{opacity:1;transform:translate(-50%,-50%)}.portrait-link:hover .portrait-focus{opacity:1}.portrait-link:hover :global(img){filter:brightness(.83)}}
  @keyframes quiz-beacon{0%,100%{opacity:1;box-shadow:0 0 0 0 #328ea926}50%{opacity:.45;box-shadow:0 0 0 4px #328ea900}}
  .about-note{min-width:0;padding-block:8px}
  .about-note h2{font-family:var(--serif);font-size:clamp(48px,5.5vw,76px);font-weight:400;line-height:1.05;letter-spacing:-.025em;margin:0 0 24px}
  .about-lead{font:clamp(20px,1.8vw,24px)/1.65 var(--serif-zh);letter-spacing:.015em;color:var(--ink);margin:0 0 18px;text-wrap:balance}
  .about-excerpt{font:14px/2 var(--sans);color:var(--muted);margin:0;max-width:34em}
  .about-link{display:inline-flex;align-items:center;gap:24px;margin-top:22px;padding:8px 10px 8px 21px;border:1px solid #b8aa95;border-radius:999px;color:#80684c;font:15px var(--serif-zh);letter-spacing:.16em;min-height:44px;transition:background .2s,border-color .2s}
  .about-arrow{display:grid;place-items:center;width:28px;height:28px;border:1px solid #c9bfad;border-radius:50%;font:17px var(--sans);letter-spacing:0;transition:transform .2s}
  .about-link:hover{background:#ebe5d8;border-color:#80684c}
  .about-link:hover .about-arrow{transform:rotate(8deg)}
  .quiz-fallback{display:block;margin-top:16px;color:#237489;font-size:13px}
  .without-portrait{grid-template-columns:1fr;max-width:700px}
  @media(max-width:760px){
    .home-about{padding-block:24px 40px}
    .about-rule{margin-bottom:24px;padding-top:18px}
    .about-rule .eyebrow{font-size:9px;letter-spacing:.15em}
    .about-spread{grid-template-columns:1fr;gap:26px}
    .about-note{padding:0}
    .about-note h2{font-size:54px;margin-bottom:18px}
    .about-lead{font-size:21px;margin-bottom:14px}
    .about-excerpt{font-size:14px;line-height:1.9}
    .about-link{margin-top:18px}
    .portrait-caption{padding-top:12px;gap:12px}
    .portrait-invite{font-size:15px;padding:12px 16px}
  }
  @media(prefers-reduced-motion:reduce){.about-link,.about-arrow,.portrait-invite,.portrait-focus,.portrait-link :global(img){transition:none}.quiz-dot{animation:none}}
</style>
