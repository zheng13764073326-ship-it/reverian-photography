---
import Photo from './Photo.astro';
import SocialLinks from './SocialLinks.astro';
import type {Settings} from '../lib/types';
interface Props {settings:Settings}
const {settings}=Astro.props;
const headingIndex=settings.about.findIndex(block=>block.style==='h2');
const heading=headingIndex>=0?settings.about[headingIndex].children.map(span=>span.text).join(''):'';
const firstParagraph=settings.about.slice(headingIndex>=0?headingIndex+1:0).find(block=>(!block.style||block.style==='normal')&&block.children?.some(span=>span.text));
const introduction=settings.introduction||firstParagraph?.children.map(span=>span.text).join('')||'';
---
<section id="about" class="container home-about" aria-labelledby="home-about-name">
  <div class="about-rule"><p class="eyebrow">ABOUT THE PHOTOGRAPHER</p><span aria-hidden="true">关于我</span></div>
  <div class:list={['about-spread',{'without-portrait':!settings.portrait}]}>
    {settings.portrait&&<div class="portrait-column"><a href="/about/?quiz=start#tacit" class="portrait-link" aria-label="测测我们的默契度，点击开始">
      <div class="portrait-stage">
        <Photo photo={{...settings.portrait.photo,alt:settings.portrait.photo.alt.replace("，底部写着 A moment, held in light.","")}} ratio={1} caption={false} lightbox={false} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) 50vw, 640px"/>
        <span class="portrait-focus" aria-hidden="true"></span>
        <span class="portrait-invite" aria-hidden="true">测测我们的默契度<span>↗</span></span>
      </div>
      <span class="portrait-caption"><span class="quiz-label"><i class="quiz-dot" aria-hidden="true"></i>默契度</span><span class="quiz-caption-hint">十道题，看看你多懂我</span><span class="quiz-caption-arrow" aria-hidden="true">↗</span></span>
    </a>
      <a class="about-btn about-btn-desktop" href="/about/" data-elastic-button><span class="elastic-button-face"><span class="elastic-button-label">关于我</span><span class="about-arrow" aria-hidden="true">↗</span></span></a>
    </div>}
    <div class="about-note">
      <h2 id="home-about-name" aria-label={`挽风 | ${settings.photographer}`}><svg class="about-signature" viewBox="498 840 984 407" aria-hidden="true"><image href="/images/branding/wanfeng-white.webp" width="2000" height="2000"/></svg><span class="about-name-separator" aria-hidden="true">|</span><span>{settings.photographer}</span></h2>
      {heading&&<p class="about-lead">{heading}</p>}
      {introduction&&<p class="about-excerpt">{introduction}</p>}
      <a class:list={['about-btn',{'about-btn-mobile':Boolean(settings.portrait)}]} href="/about/" data-elastic-button><span class="elastic-button-face"><span class="elastic-button-label">关于我</span><span class="about-arrow" aria-hidden="true">↗</span></span></a>
      {!settings.portrait&&<a class="quiz-fallback" href="/about/?quiz=start#tacit">测测我们的默契度 ↗</a>}
      <SocialLinks links={settings.socialLinks} compact id="home-social-title"/>
    </div>
  </div>
</section>
<style>
  .home-about{padding-block:32px 0}
  .about-rule{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:22px;margin-bottom:38px;color:var(--muted)}
  .about-rule .eyebrow{margin:0;font-size:13px;letter-spacing:.22em}
  .about-rule>span{font:15px var(--serif-zh);letter-spacing:.16em;white-space:nowrap}
  .about-spread{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(32px,5vw,72px);align-items:end}
  .portrait-column{min-width:0}
  .portrait-link{display:block;min-width:0;--quiz-blue:#237489}
  .portrait-stage{position:relative;display:block;isolation:isolate}
  .portrait-link :global(figure){margin:0}
  .portrait-link :global(img){width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block;transition:filter .3s}
  .portrait-link:focus-visible{outline:2px solid var(--quiz-blue);outline-offset:6px}
  .portrait-focus{position:absolute;inset:16px;border:1px solid #86c5d180;pointer-events:none;opacity:0;transition:opacity .25s}
  .portrait-focus::before,.portrait-focus::after{content:'';position:absolute;width:22px;height:22px;border-color:#9cdeeb;border-style:solid}
  .portrait-focus::before{top:-1px;left:-1px;border-width:2px 0 0 2px}
  .portrait-focus::after{right:-1px;bottom:-1px;border-width:0 2px 2px 0}
  .portrait-invite{position:absolute;top:50%;left:50%;transform:translate(-50%,calc(-50% + 8px));display:flex;align-items:center;gap:12px;white-space:nowrap;padding:0;border:0;background:transparent;color:#b6edf5;font:18px var(--serif-zh);text-shadow:0 1px 6px #000a;letter-spacing:.08em;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none}
  .portrait-caption{display:flex;align-items:center;gap:14px;padding-top:14px;font:14px/1.6 var(--sans);color:var(--muted)}
  .quiz-label{display:inline-flex;align-items:center;gap:8px;color:var(--quiz-blue);font-size:15px;letter-spacing:.14em}
  .quiz-dot{width:6px;height:6px;border-radius:50%;background:#328ea9;animation:quiz-beacon 2.4s ease-in-out infinite}
  .quiz-caption-arrow{margin-left:auto;font-size:17px;color:var(--quiz-blue)}
  .portrait-link:focus-visible .portrait-invite{opacity:1;transform:translate(-50%,-50%)}
  .portrait-link:focus-visible .portrait-focus{opacity:1}
  @media(hover:hover){.portrait-link:hover .portrait-invite{opacity:1;transform:translate(-50%,-50%)}.portrait-link:hover .portrait-focus{opacity:1}.portrait-link:hover :global(img){filter:brightness(.83)}}
  @keyframes quiz-beacon{0%,100%{opacity:1;box-shadow:0 0 0 0 #328ea926}50%{opacity:.45;box-shadow:0 0 0 4px #328ea900}}
  .about-note{min-width:0;padding-block:8px 0}
  .about-note h2{display:flex;align-items:center;gap:.22em;font-family:var(--serif);font-size:clamp(36px,4.5vw,64px);font-weight:400;line-height:1.05;letter-spacing:-.025em;margin:0 0 24px}
  .about-signature{display:block;width:1.85em;height:auto;aspect-ratio:984/407;flex:none;overflow:hidden;filter:brightness(0);opacity:.86}
  .about-name-separator{font-size:.7em;color:var(--muted)}
  .about-lead{font:600 clamp(20px,1.8vw,24px)/1.65 var(--serif-zh);letter-spacing:.015em;color:#2C2B29;font-synthesis:none;margin:0 0 18px;text-wrap:balance}
  .about-excerpt{font:400 16px/2 var(--serif-zh);color:#2C2B29;margin:0;max-width:34em;font-synthesis:none}
  .about-btn{--press-depth:0px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0;background:transparent;color:#F4F3EE;border:none;border-radius:999px;font-family:var(--serif-zh);font-size:16px;font-weight:500;font-synthesis:none;letter-spacing:.08em;margin-top:8px}
  .about-btn .elastic-button-face{padding:12px 32px;background-color:var(--elastic-face-bg,#1E4D54)}
  .about-btn-desktop{margin-top:16px}
  .about-btn-mobile{display:none}
  .about-arrow{display:inline-block;letter-spacing:0;transition:transform .35s var(--press-spring)}
  .about-btn:focus-visible{outline:2px solid #1E4D54;outline-offset:4px}
  @media(hover:hover){.about-btn:hover .elastic-button-face{background-color:var(--elastic-face-bg,#163A40)}}
  .quiz-fallback{display:block;margin-top:16px;color:#237489;font-size:16px}
  .without-portrait{grid-template-columns:1fr;max-width:700px}
  @media(max-width:760px){
    .home-about{padding-block:24px 0}
    .about-rule{margin-bottom:24px;padding-top:18px}
    .about-rule .eyebrow{font-size:12px;letter-spacing:.15em}
    .about-spread{grid-template-columns:1fr;gap:26px}
    .about-btn-desktop{display:none}
    .about-btn-mobile{display:inline-flex}
    .about-note{padding:0}
    .about-note h2{font-size:clamp(34px,9vw,48px);margin-bottom:18px}
    .about-lead{font-size:21px;margin-bottom:14px}
    .about-excerpt{line-height:1.9}
    .portrait-caption{padding-top:12px;gap:12px}
    .portrait-invite{font-size:17px}
  }
  @media(prefers-reduced-motion:reduce){.about-btn,.about-arrow,.portrait-invite,.portrait-focus,.portrait-link :global(img){transition:none}.quiz-dot{animation:none}}
</style>
