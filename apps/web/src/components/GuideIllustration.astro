---
interface Props {id:string}
const {id}=Astro.props;
// SVG geometry uses millimetre-derived dimensions; strokes stay one CSS pixel at every size.
const fine={'vector-effect':'non-scaling-stroke','shape-rendering':'crispEdges','stroke-width':1} as const;
const formats=[
  {name:'FF 36×24',width:162,height:108,labelX:280,labelY:49,anchor:'end'},
  {name:'APS-C',width:105.75,height:70.2,labelX:223.75,labelY:89,anchor:'end'},
  {name:'M4/3',width:77.85,height:58.5,labelX:232,labelY:119,anchor:'start'},
  {name:'1"',width:59.4,height:39.6,labelX:169.4,labelY:143,anchor:'end'}
];
const focalLengths=[20,28,35,50,70,85,200];
const apertures=['f/1.4','f/2','f/2.8','f/4','f/5.6','f/8'];
const focalX=(index:number)=>52+296*index/6;
const frames=[{focal:28,width:216,height:144},{focal:35,width:173,height:115},{focal:50,width:121,height:81},{focal:85,width:71,height:47}];
function framePath(width:number,height:number){
  const l=200-width/2,r=200+width/2,t=108-height/2,b=108+height/2,c=10;
  return `M${l} ${t+c}V${t}H${l+c} M${r-c} ${t}H${r}V${t+c} M${r} ${b-c}V${b}H${r-c} M${l+c} ${b}H${l}V${b-c} M200 ${t-2}v4 M200 ${b-2}v4 M${l-2} 108h4 M${r-2} 108h4`;
}
const meterX=(index:number)=>64+272*index/12;
---
<svg class="pg-illustration pg-scale-illustration" viewBox="0 0 400 210" fill="none" aria-hidden="true">
  {id==='camera' && <>
    <g class="pg-scale-faint">
      <path {...fine} d="M110 58V174H280"/>
      {Array.from({length:37},(_,i)=><path {...fine} d={`M${118+i*4.5} 174v${i%5===0?2:1}`}/>)}
      {Array.from({length:25},(_,i)=><path {...fine} d={`M110 ${166-i*4.5}h-${i%5===0?2:1}`}/>)}
    </g>
    {formats.map((format,index)=><g class="pg-sensor-format" style={`--format-delay:${index*60}ms`}>
      <rect {...fine} class:list={['pg-sensor-frame',{'pg-sensor-full':index===0}]} x="118" y={166-format.height} width={format.width} height={format.height}/>
      {index===2&&<path {...fine} class="pg-sensor-leader" d="M195.85 107.5h8l22 8"/>}
      <text class="pg-sensor-label" x={format.labelX} y={format.labelY} text-anchor={format.anchor}>{format.name}</text>
    </g>)}
    <text class="pg-scale-unit" x="284" y="177">MM</text>
  </>}
  {id==='lens' && <>
    <path {...fine} class="pg-scale-faint" d="M52 112H348"/>
    {focalLengths.map((focal,index)=><g>
      <path {...fine} class="pg-scale-strong" d={`M${focalX(index)} 94v18`}/>
      <text class:list={['pg-focal-label',{'pg-focal-35':focal===35,'pg-focal-85':focal===85}]} x={focalX(index)} y="84" text-anchor="middle">{focal}</text>
      {index<6&&[1,2,3].map(step=><path {...fine} class="pg-scale-faint" d={`M${focalX(index)+296/24*step} ${step===2?103:106}V112`}/>)}
    </g>)}
    <text class="pg-scale-unit" x="369" y="84">MM</text>
    <g class="pg-focal-pointer">
      <path d={`M${focalX(2)-4} 58h8l-4 6z`} fill="currentColor"/>
      <path {...fine} d={`M${focalX(2)} 92v32`} stroke="currentColor"/>
    </g>
    {apertures.map((aperture,index)=><text class:list={['pg-ring-aperture',{'pg-ring-fast':index===0}]} x={52+296*index/5} y="154" text-anchor="middle">{aperture}</text>)}
  </>}
  {id==='focal-length' && <>
    {frames.map((frame,index)=><g class:list={['pg-frameline',index<2?'pg-frameline-outer':'pg-frameline-inner']}>
      <path {...fine} class="pg-frame-outline" d={framePath(frame.width,frame.height)}/>
      <text x={200-frame.width/2+18} y={108-frame.height/2+10}>{frame.focal}</text>
    </g>)}
    <path {...fine} class="pg-frame-cross" d="M196 108h8m-4-4v8"/>
    <text class="pg-angle-reading" x="348" y="196" text-anchor="end">84° → 28°</text>
  </>}
  {id==='exposure' && <>
    <path {...fine} class="pg-scale-faint" d="M64 96H336"/>
    {Array.from({length:13},(_,index)=><g>
      <path {...fine} class:list={[index%3===0?'pg-scale-strong':'pg-scale-faint',{'pg-meter-zero':index===6}]} d={`M${meterX(index)} 96v${index%3===0?16:7}`}/>
      {index%3===0&&<text class:list={['pg-meter-number',{'pg-meter-zero':index===6}]} x={meterX(index)} y="82" text-anchor="middle">{index===6?'0':index<6?String(index/3-2):`+${index/3-2}`}</text>}
    </g>)}
    <path class="pg-meter-pointer" d={`M${meterX(4)} 116v12`} stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" shape-rendering="crispEdges"/>
    <g class="pg-meter-telemetry">
      <text x="64" y="150">f/2.8</text>
      <text class="pg-meter-rest" x="145" y="150">1/1000</text><text class="pg-meter-active" x="145" y="150">1/500</text>
      <text x="224" y="150">ISO 100</text>
      <text class="pg-meter-status pg-meter-rest" x="336" y="150" text-anchor="end">EV -0.7</text><text class="pg-meter-status pg-meter-active" x="336" y="150" text-anchor="end">EV 0.0</text>
    </g>
  </>}
</svg>
