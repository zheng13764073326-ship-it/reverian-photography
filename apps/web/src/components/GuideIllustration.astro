---
interface Props {id:string}
const {id}=Astro.props;
---
<svg class="pg-illustration" viewBox="0 0 600 319" fill="none" aria-hidden="true">
  {id==='camera' && <>
    <g class="pg-optical-lines">
      <path d="M166 105h47l14-25h111l18 25h70v122H166z"/><path d="M177 113v105h27M394 113h22v105h-23M244 87h77M176 99v-7h27v7"/>
      <rect x="370" y="119" width="27" height="16" rx="2"/><circle cx="300" cy="161" r="65"/><circle cx="300" cy="161" r="56"/><circle cx="300" cy="161" r="44" stroke-dasharray="1 5"/>
      <path d="M146 151h-18m9-9v18M447 151h18m-9-9v18" opacity=".4"/>
    </g>
    <g class="pg-aperture-leaves" stroke="currentColor" stroke-width="1.2">
      {[0,60,120,180,240,300].map(angle=><path transform={`rotate(${angle} 300 161)`} d="m300 132 25 14 16-12-19-16-22 3z" fill="currentColor" fill-opacity=".1"/>)}
      <path d="m300 132 25 14v29l-25 15-25-15v-29z"/>
    </g>
    <g class="pg-format-labels" text-anchor="middle"><text x="208" y="267">FULL FRAME</text><text x="316" y="267">APS-C</text><text x="400" y="267">M4/3</text></g>
  </>}
  {id==='lens' && <>
    <path class="pg-optical-lines" d="M106 226h388" stroke-dasharray="2 6" opacity=".35"/>
    <g class="pg-lens pg-lens-wide">
      <g class="pg-optical-lines"><path d="M157 141v70q36 16 72 0v-70M157 183q36 16 72 0m-72 6q36 16 72 0m-72 7q36 16 72 0"/><ellipse cx="193" cy="141" rx="36" ry="10"/><ellipse cx="193" cy="141" rx="27" ry="6"/><path d="M176 152q-8 24 0 31m34-31q8 24 0 31" stroke="currentColor"/></g>
      <text x="193" y="249">24mm</text><text class="pg-lens-aperture" x="193" y="274">f/2.8</text>
    </g>
    <g class="pg-lens">
      <g class="pg-optical-lines"><path d="M267 113v96q44 19 88 0v-96M267 176q44 19 88 0m-88 7q44 19 88 0m-88 7q44 19 88 0"/><ellipse cx="311" cy="113" rx="44" ry="13"/><ellipse cx="311" cy="113" rx="33" ry="9"/><path d="M289 128q-10 26 0 48m44-48q10 26 0 48" stroke="currentColor"/></g>
      <text x="311" y="249">50mm</text><text class="pg-lens-aperture" x="311" y="274">f/1.8</text>
    </g>
    <g class="pg-lens pg-lens-tele">
      <g class="pg-optical-lines"><path d="M386 90v79l8 12v26q45 20 90 0v-26l8-12V90M394 182q45 19 90 0m-90 7q45 19 90 0m-90 7q45 19 90 0"/><ellipse cx="439" cy="90" rx="53" ry="17"/><ellipse cx="439" cy="90" rx="42" ry="12"/><path d="M410 108q-17 33 0 65m58-65q17 33 0 65m-49-60q9 25 0 48m40-48q-9 25 0 48" stroke="currentColor"/></g>
      <text x="439" y="249">85mm</text><text class="pg-lens-aperture" x="439" y="274">f/1.4</text>
    </g>
  </>}
  {id==='focal-length' && <>
    <defs><clipPath id="pg-fov-clip"><rect x="345" y="74" width="154" height="165"/></clipPath></defs>
    <g class="pg-optical-lines"><path d="M96 160h232" stroke-dasharray="3 6" opacity=".5"/><circle cx="110" cy="160" r="5" fill="currentColor"/><path d="M151 123a55 55 0 0 1 0 74" opacity=".6"/><path d="M345 89V74h15m124 0h15v15m0 135v15h-15m-124 0h-15v-15"/>
      <path class="pg-ray pg-ray-top" d="M110 160h175"/><path class="pg-ray pg-ray-bottom" d="M110 160h175"/>
      <rect x="338" y="67" width="168" height="179" rx="2" opacity=".3"/>
    </g>
    <g clip-path="url(#pg-fov-clip)">
      <path d="M345 211h154" stroke="#7c969e" opacity=".35"/>
      <g class="pg-fov-subject pg-optical-lines"><path d="m392 208 14-50 15-19 15 19 14 50z"/><path d="M421 139v69m-29 0h58M406 158h30"/><circle cx="462" cy="111" r="10" opacity=".55"/></g>
    </g>
    <g class="pg-fov-readout" text-anchor="middle"><text class="pg-fov-wide" x="207" y="279">24MM · 84°</text><text class="pg-fov-tele" x="207" y="279">85MM · 28°</text><text x="422" y="279">FIELD OF VIEW</text></g>
  </>}
  {id==='exposure' && <>
    <g class="pg-optical-lines"><path d="M300 87 210 243H390Z"/><path d="M300 87v104m-90 52 90-52 90 52" stroke-dasharray="2 6" opacity=".35"/><circle cx="300" cy="87" r="3"/><circle cx="390" cy="243" r="3"/><circle cx="210" cy="243" r="3"/></g>
    <g text-anchor="middle" class="pg-triangle-labels"><text class="pg-vertex-a" x="300" y="61">APERTURE · 光圈</text><text class="pg-vertex-s" x="413" y="278">SHUTTER · 快门</text><text class="pg-vertex-i" x="193" y="278">ISO · 感光度</text></g>
    <text class="pg-ev" x="300" y="199" text-anchor="middle">EV 0</text>
    <circle class="pg-exposure-dot" cx="300" cy="87" r="4" fill="currentColor"/>
  </>}
</svg>
