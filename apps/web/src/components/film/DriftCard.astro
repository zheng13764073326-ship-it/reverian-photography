---
import issue from '../../data/film/drift-01.json';
const rows=[[35,9,22,11,34,28],[10,36,19,23,33,12]].map(ids=>ids.map(id=>issue.photos.find(photo=>photo.id===id)!));
---
<div class="film-reel" data-film-reel>
 <a class="drift-card" href="/film/spring-drift-2026/" aria-label="进入暗房，翻阅春日胶片漂流">
  {rows.map((photos,row)=><div class="reel-row" aria-hidden="true">
   <div class:list={['reel-track',{'reel-reverse':row===1}]}>
    {[0,1].map(()=> <div class="reel-copy">
     {photos.map(photo=><figure class="reel-frame">
      <img src={photo.preview} srcset={photo.srcset} sizes="(max-width:600px) 240px, 340px" width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async"/>
      <figcaption><span>{String(photo.number).padStart(2,'0')}A</span><span>SILVER HALIDE <span class="reel-arrow">▸</span></span></figcaption>
     </figure>)}
    </div>)}
   </div>
  </div>)}
 </a>
 <button class="reel-toggle" type="button" aria-label="暂停胶片滚动" aria-pressed="false" title="暂停胶片滚动">
  <svg class="reel-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"/></svg>
  <svg class="reel-play" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z"/></svg>
 </button>
</div>
<style>
 .film-reel{position:relative;margin:0 0 32px;--reel-height:clamp(164px,17vw,232px);--reel-gap:14px;--reel-gold:#c7a065}
 .drift-card{display:block;color:var(--reel-gold)}
 .reel-row{position:relative;overflow:hidden;background:#1c1b18;padding:25px 0 31px;isolation:isolate}
 .reel-row+.reel-row{margin-top:12px}
 .reel-row::before,.reel-row::after{content:'';position:absolute;inset-inline:0;height:10px;z-index:1;pointer-events:none;background:repeating-linear-gradient(90deg,transparent 0 10px,#f2f0e9 10px 19px,transparent 19px 29px);opacity:.9}
 .reel-row::before{top:7px}.reel-row::after{bottom:7px}
 .reel-track{display:flex;width:max-content;animation:film-travel 72s linear infinite;animation-play-state:paused;will-change:transform}
 .reel-reverse{animation-direction:reverse;animation-duration:80s}
 .reel-copy{display:flex;gap:var(--reel-gap);padding-right:var(--reel-gap);flex-shrink:0}
 .reel-frame{margin:0;flex:none}
 .reel-frame img{display:block;width:auto;height:var(--reel-height);max-width:none;object-fit:contain;background:#292722}
 .reel-frame figcaption{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:6px 2px 0;font:10px/1.2 'Courier New',monospace;letter-spacing:.13em;color:var(--reel-gold)}
 .reel-frame figcaption>span:first-child{font-size:12px}.reel-arrow{padding-left:8px}
 [data-visible="true"][data-paused="false"] .reel-track{animation-play-state:running}
 .drift-card:focus-visible .reel-track{animation-play-state:paused}
 .reel-toggle{position:absolute;right:12px;bottom:40px;z-index:2;display:grid;place-items:center;width:36px;height:36px;border:1px solid #c7a06580;border-radius:50%;background:#1c1b18e8;color:#e8d6b4;cursor:pointer}
 .reel-toggle svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5}.reel-toggle .reel-play{display:none}
 [data-paused="true"] .reel-toggle .reel-play{display:block}[data-paused="true"] .reel-toggle .reel-pause{display:none}
 .drift-card:focus-visible,.reel-toggle:focus-visible{outline:2px solid #aa7d42;outline-offset:4px}
 @media(hover:hover){.drift-card:hover .reel-track{animation-play-state:paused}}
 @keyframes film-travel{to{transform:translateX(-50%)}}
 @media(max-width:600px){.film-reel{--reel-height:154px;--reel-gap:10px}.reel-row+.reel-row{margin-top:10px}.reel-frame figcaption{font-size:8px;letter-spacing:.07em}.reel-toggle{right:8px;width:34px;height:34px}}
 @media(prefers-reduced-motion:reduce){.reel-track{animation:none;transform:none;will-change:auto}.reel-copy:nth-child(2){display:none}.reel-row{overflow-x:auto;scrollbar-width:thin;scrollbar-color:#9c8155 #1c1b18}.reel-toggle{display:none}}
</style>
<script>
 document.querySelectorAll<HTMLElement>('[data-film-reel]').forEach(reel=>{
  const button=reel.querySelector<HTMLButtonElement>('.reel-toggle')!;
  reel.dataset.paused='false';
  let visible=false;
  const syncVisibility=()=>{reel.dataset.visible=String(visible&&!document.hidden);};
  const observer=new IntersectionObserver(entries=>{
   visible=entries[0].isIntersecting;
   if(visible)reel.querySelectorAll<HTMLImageElement>('img').forEach(img=>{img.loading='eager';});
   syncVisibility();
  });
  observer.observe(reel);
  document.addEventListener('visibilitychange',syncVisibility);
  button.addEventListener('click',()=>{
   const paused=reel.dataset.paused!=='true';
   reel.dataset.paused=String(paused);
   button.setAttribute('aria-pressed',String(paused));
   const label=paused?'继续胶片滚动':'暂停胶片滚动';
   button.setAttribute('aria-label',label);button.title=label;
  });
 });
</script>
