---
import type {Settings} from '../lib/types';
import {demoPhotos} from '../data/demo';
import {imageUrl} from '../lib/images';
import assets from '../data/assets.json';
import portraitAsset from '../data/home-mobile-cover.json';
interface Props {settings:Settings}
const {settings}=Astro.props;
const desk=settings.homePresentation==='desk';
const desktop=settings.homeCover,mobile=settings.mobileCover||desktop;
const spots=[
 {id:'stilllight',hit:'400,294 831,198 911,486 449,588'},
 {id:'gardenchair',hit:'861,41 1177,75 1143,432 945,411 861,160'},
 {id:'afternoon',hit:'1233,200 1540,301 1415,637 1077,533'},
];
const mobileSources=mobile?[400,800,1200].map(w=>`${imageUrl(mobile.photo,w,mobile,9/16)} ${w}w`).join(', '):undefined;
const fullRoadMobile=desktop?.photo.id==='kinmen-2026-14'&&mobile?.photo.id==='kinmen-2026-14';
const portraitSources=portraitAsset.images.map(image=>`${image.src} ${image.width}w`).join(', ');
const desktopSources=desktop?[...new Set([800,1200,1920,2560,3200,4096].map(w=>Math.min(w,desktop.photo.image.width)))].map(w=>`${imageUrl(desktop.photo,w)} ${w}w`).join(', '):undefined;
const portraitImage=(width:number)=>portraitAsset.images.find(image=>image.width>=width)||portraitAsset.images[portraitAsset.images.length-1];
const canopy=(baseWidth:number)=>`image-set(${[1,2,3].map(dpr=>`url('${portraitImage(baseWidth*dpr).src}') ${dpr}x`).join(', ')})`;
const mobileStyle=fullRoadMobile?`--mobile-aspect:${portraitAsset.width}/${portraitAsset.height};--mobile-placeholder:url('${portraitAsset.lqip}');--mobile-canopy:${canopy(400)};--mobile-canopy-wide:${canopy(800)}`:undefined;
---
<section class:list={['home-cover',{'editorial-cover':!desk}]} aria-label="Reverian 摄影封面" data-full-road={fullRoadMobile||undefined} style={mobileStyle}>
 {desk ? <>
  <img class="hero-photo" src={`/images/responsive/home-desk-${assets['home-desk'].width}.webp`} srcset={assets['home-desk'].widths.map(w=>`/images/responsive/home-desk-${w}.webp ${w}w`).join(', ')} sizes="(max-aspect-ratio: 16/9) 178svh, 100vw" width={assets['home-desk'].width} height={assets['home-desk'].height} alt="暖光中的摄影桌面，照片盒与桌面上摆放着三张照片" fetchpriority="high"/>
  <svg class="photo-hotspots" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" aria-label="点击照片放大">{spots.map(s=>{const p=demoPhotos.find(p=>p.id===s.id)!;return <a href={imageUrl(p,2400)} data-lightbox data-group="cover" data-title={p.title} data-alt={p.alt} data-caption="封面场景中的示例照片" aria-label={`放大查看：${p.title}`}><polygon points={s.hit}/></a>;})}</svg>
 </> : desktop ? <>
  <picture class="cover-picture">
   {mobile && <source media="(max-width: 800px) and (orientation: portrait)" srcset={fullRoadMobile?portraitSources:mobileSources} sizes="100vw" width={fullRoadMobile?portraitAsset.width:900} height={fullRoadMobile?portraitAsset.height:1600} data-fallback-src={fullRoadMobile?portraitAsset.images[0].src:imageUrl(mobile.photo,400,mobile,9/16)}/>}
   <img class="hero-photo" src={imageUrl(desktop.photo,1920)} srcset={desktopSources} sizes="100vw" data-fallback-src={imageUrl(desktop.photo,800)} width={desktop.photo.image.width} height={desktop.photo.image.height} style={`--focus-desktop:${desktop.focusX*100}% ${desktop.focusY*100}%;--focus-mobile:${mobile!.focusX*100}% ${mobile!.focusY*100}%`} alt={desktop.photo.alt} fetchpriority="high"/>
  </picture>
  <div class="cover-shade" aria-hidden="true"></div>
 </> : <div class="empty-cover">Reverian Photography</div>}
 {desk ? <>
  <div class="home-identity"><h1>{settings.photographer}</h1><p>{settings.genres}</p><p class="motto">{settings.motto}</p></div>
 </> : <>
  <div class="home-identity">
   <p class="cover-eyebrow">PHOTOGRAPHY PORTFOLIO</p>
   <h1>{settings.photographer}</h1>
  </div>
  <div class="cover-note">
   <p class="cover-note-zh">漫游 · 凝视 · 显影</p>
   <p class="cover-note-en" lang="en">Wanderings &amp; Reverie</p>
  </div>
 </>}
</section>
<style>
 .editorial-cover{height:100svh;min-height:500px;background:#19251e;color:#f5f0df;isolation:isolate}
 .editorial-cover .cover-picture{position:absolute;inset:0;z-index:-2}
 .cover-shade{position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(180deg,rgba(9,22,14,.42) 0%,rgba(12,24,16,.12) 52%,rgba(9,18,12,.04) 70%,rgba(8,16,11,.45) 100%),radial-gradient(ellipse 42% 43% at 50% 21%,rgba(17,27,22,.52),transparent 100%)}
 .editorial-cover .home-identity{inset:22% 20px auto;text-align:center;text-shadow:none}
 .editorial-cover .cover-eyebrow{font:500 clamp(11px,1.05vw,18px)/1.4 'Cormorant Garamond',Georgia,serif;letter-spacing:.42em;margin:0 0 12px;padding-left:.42em;white-space:nowrap}
 .editorial-cover .home-identity h1{font:italic 400 clamp(100px,10.8vw,182px)/.85 'Cormorant Garamond',Georgia,serif;letter-spacing:-.045em;margin:0;white-space:nowrap}
 .cover-note{position:absolute;left:clamp(24px,3.6vw,60px);bottom:max(24px,env(safe-area-inset-bottom));max-width:calc(50% - 80px);text-shadow:0 1px 10px rgba(0,0,0,.65)}
 .cover-note p{margin:0}
 .cover-note .cover-note-zh{font:400 clamp(14px,1.1vw,18px)/1.65 var(--serif-zh);letter-spacing:.04em}
 .cover-note .cover-note-en{font:italic 400 clamp(16px,1.2vw,20px)/1.4 "Cormorant Garamond",Georgia,serif;margin-top:4px}
 @media(max-width:800px) and (orientation:portrait){
  .editorial-cover{min-height:520px}
  .editorial-cover .hero-photo{object-position:var(--focus-mobile,center)}
  /* Preserve the full width of the portrait: never crop the road edges.
     On taller phones only the upper canopy fills the additional space. */
  .editorial-cover[data-full-road]{background-image:var(--mobile-canopy),var(--mobile-placeholder);background-size:100% auto;background-position:center -20vw;background-repeat:no-repeat}
  /* Reserve the portrait frame before decoding, including retries that remove source.
     The placeholder shares this frame so the road never appears at another height. */
  .editorial-cover[data-full-road] .cover-picture{inset:auto 0 0;width:100%;height:auto;aspect-ratio:var(--mobile-aspect);background:var(--mobile-placeholder) center/100% 100% no-repeat;mask-image:linear-gradient(to bottom,transparent,black 10%)}
  .editorial-cover[data-full-road] .hero-photo{inset:0;width:100%;height:100%;object-fit:contain;object-position:bottom}
  .editorial-cover[data-full-road] .cover-shade{background:linear-gradient(180deg,rgba(6,17,10,.16),rgba(6,17,10,.22) 30%,transparent 53%,rgba(5,13,8,.12) 100%)}
  .cover-shade{background:linear-gradient(180deg,rgba(8,20,13,.4),rgba(10,23,15,.52) 26%,rgba(10,23,15,.28) 43%,transparent 62%,rgba(7,16,11,.36) 100%)}
  .editorial-cover .home-identity{inset:25% 12px auto}
  .editorial-cover .cover-eyebrow{font-size:clamp(10px,2.75vw,18px);letter-spacing:.3em;padding-left:.3em;margin-bottom:16px}
  .editorial-cover .home-identity h1{font-size:clamp(84px,27.5vw,195px);letter-spacing:-.045em;line-height:.95}
  .cover-note{left:22px;right:22px;bottom:max(24px,calc(env(safe-area-inset-bottom) + 16px));max-width:none}
  .cover-note .cover-note-zh{font-size:clamp(13px,3.55vw,17px);letter-spacing:.02em}
  .cover-note .cover-note-en{font-size:16px;line-height:1.35}
 }
 @media(min-width:401px) and (max-width:800px) and (orientation:portrait){
  .editorial-cover[data-full-road]{background-image:var(--mobile-canopy-wide),var(--mobile-placeholder)}
 }
 @media(max-height:520px) and (orientation:landscape){
  .editorial-cover{min-height:360px}
  .editorial-cover .home-identity{top:32%}
  .editorial-cover .home-identity h1{font-size:clamp(80px,10vw,120px)}
  .editorial-cover .cover-eyebrow{font-size:10px;margin-bottom:7px}
  .cover-note{bottom:max(16px,env(safe-area-inset-bottom));max-width:calc(50% - 64px)}
  .cover-note .cover-note-zh{font-size:13px}
  .cover-note .cover-note-en{font-size:15px;line-height:1.2;margin-top:2px}
 }
</style>
