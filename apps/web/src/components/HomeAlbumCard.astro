---
import Photo from './Photo.astro';
import type {Album} from '../lib/types';
interface Props {album:Album;lead?:boolean}
const {album,lead=false}=Astro.props;
const count=new Set([album.cover.photo.id,...album.spreads.flatMap(spread=>spread.photos.map(photo=>photo.id))]).size;
const date=album.date.slice(0,7).replace('-', '.');
const sizes=lead?'(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1280px) calc(100vw - 80px), 1200px':'(max-width: 600px) calc(100vw - 40px), (max-width: 760px) calc(100vw - 48px), (max-width: 1280px) calc((100vw - 112px) / 2), 584px';
---
<article class:list={['album-card','home-album',{'home-album-lead':lead}]}>
 <a class="home-album-link" href={'/albums/'+album.slug+'/'} aria-label={'翻开影集：'+album.title}>
  <Photo photo={album.cover.photo} cover={album.cover} ratio={3/2} caption={false} lightbox={false} sizes={sizes}/>
  <div class="home-album-caption">
   <div class="home-album-copy">
    <p class="home-album-details"><time datetime={album.date}>{date}</time><span aria-hidden="true">·</span><span>{count} 张照片</span></p>
    <h3>{album.title}</h3>
   </div>
   <span class="home-album-open" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  </div>
 </a>
</article>
<style>
 .home-album{min-width:0}
 .home-album-link{position:relative;display:block}
 .home-album-caption{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:20px;pointer-events:none}
 .home-album-details{display:flex;align-items:center;gap:10px;margin:0 0 8px;font:400 12px/1.5 var(--sans);letter-spacing:.06em;color:var(--muted)}
 .home-album h3{font:500 clamp(22px,2vw,28px)/1.5 var(--serif-zh);letter-spacing:.025em;margin:0;transform:none!important;text-decoration:none!important;transition:color .25s}
 .home-album-open{display:grid;place-items:center;flex:none;width:46px;height:46px;border:1px solid var(--line);border-radius:50%;color:var(--ink);transition:background-color .25s,border-color .25s}
 .home-album-open svg{width:20px;height:20px;transition:transform .35s ease}
 .home-album-lead{grid-column:1/-1}
 .home-album-lead :global(.image-frame){aspect-ratio:2!important}
 .home-album-lead .home-album-caption{position:absolute;inset:auto 0 0;padding:90px 40px 36px;color:#fffaf0;background:linear-gradient(transparent,rgba(12,20,22,.76));z-index:2}
 .home-album-lead .home-album-details{color:#f2eee3d9}
 .home-album-lead h3{font-size:clamp(28px,3vw,40px)}
 .home-album-lead .home-album-open{border-color:#ffffff80;color:#fffaf0;width:52px;height:52px}
 @media(hover:hover){.home-album-link:hover .home-album-open{background:#bfa462;border-color:#bfa462;color:#1d1d1b}.home-album-link:hover .home-album-open svg{transform:translate(2px,-2px)}}
 .home-album-link:focus-visible .home-album-open{background:#bfa462;border-color:#bfa462;color:#1d1d1b}
 @media(max-width:760px){
  .home-album-lead{grid-column:auto}
  .home-album-lead :global(.image-frame){aspect-ratio:3/2!important}
  .home-album-lead .home-album-caption{position:static;padding:16px 0 0;background:none;color:var(--ink)}
  .home-album-caption{padding-top:16px;gap:12px}
  .home-album h3,.home-album-lead h3{font-size:clamp(21px,5.6vw,26px)}
  .home-album-lead .home-album-details{color:var(--muted)}
  .home-album-open,.home-album-lead .home-album-open{width:42px;height:42px;border-color:var(--line);color:var(--ink)}
  .home-album-details{margin-bottom:6px}
 }
 @media(prefers-reduced-motion:reduce){.home-album-open,.home-album-open svg,.home-album h3{transition:none}.home-album-open svg{transform:none!important}}
</style>
