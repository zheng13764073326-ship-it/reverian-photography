---
import { apertureStops, apertureDescription, bokehRadius, defaultStop, lastStop, sceneStyle } from '../lib/photography-guides';

interface Props { foregroundSrc?: string; backgroundSrc?: string }
const {foregroundSrc, backgroundSrc} = Astro.props;
const initial = apertureStops[defaultStop];
// The distant lamps converge near the horizon. Nearby lamps are larger and overlap.
const lights = [
  [46, 130, 30, 'cool', .27], [64, 243, 42, 'warm', .47],
  [102, 225, 33, 'warm', .63], [118, 217, 18, 'paper', .52],
  [157, 175, 13, 'cool', .45], [172, 170, 11, 'paper', .48],
  [210, 199, 16, 'warm', .53], [231, 193, 9, 'warm', .62],
  [270, 181, 7, 'cool', .44], [288, 184, 7, 'paper', .50],
  [345, 171, 14, 'warm', .43], [362, 164, 18, 'warm', .60],
  [421, 185, 25, 'paper', .51], [448, 176, 24, 'cool', .37],
  [520, 113, 42, 'warm', .47], [562, 102, 33, 'paper', .32],
  [8, 269, 46, 'cool', .38], [163, 264, 24, 'warm', .32],
  [407, 226, 14, 'cool', .33], [545, 245, 36, 'warm', .36],
] as const;
const points = lights.map(([x, y, open, color, opacity]) => ({
  x, y, open, closed: 1.1 + open * .035, color, opacity,
}));
const sceneDescription = backgroundSrc || foregroundSrc
  ? '调整光圈可观察背景清晰程度的变化，前景始终清晰'
  : '收小光圈时，夜景散景渐渐缩成清晰的光点，底部焦点标尺始终清晰';
---
<div class="pg-demo" data-aperture-demo>
  <div class="pg-viewfinder">
    <div class="pg-scene" role="img" aria-label={sceneDescription}>
      <div class:list={['pg-scene-background', {'pg-scene-photo': backgroundSrc}]} data-aperture-background style={sceneStyle(defaultStop)}>
        {backgroundSrc ? <img src={backgroundSrc} alt="" decoding="async"/> : (
          <svg class="pg-bokeh-scene" viewBox="0 0 600 375" aria-hidden="true">
            <g class="pg-bokeh-lights">
              {points.map(({x, y, open, closed, color, opacity}) =>
                <circle class={`pg-bokeh-light pg-light-${color}`} cx={x} cy={y} r={bokehRadius(open, closed, defaultStop)}
                  opacity={opacity} data-bokeh-light data-open-radius={open} data-closed-radius={closed}/>
              )}
            </g>
            <g class="pg-bokeh-stars" fill="currentColor">
              {points.map(({x, y, open, color}) =>
                <g class={`pg-light-${color}`} transform={`translate(${x} ${y})`}>
                  {[0, 60, 120].map(angle =>
                    <path d={`M${-open * .30} 0 0 -.65 ${open * .30} 0 0 .65Z`} transform={`rotate(${angle})`}/>
                  )}
                </g>
              )}
            </g>
          </svg>
        )}
      </div>
      <div class="pg-scene-foreground">
        {foregroundSrc ? <img src={foregroundSrc} alt="" decoding="async"/> : (
          <svg viewBox="0 0 600 375" aria-hidden="true">
            <g class="pg-focus-ruler" fill="none" stroke-width="1" shape-rendering="crispEdges">
              <path d="M212 333H388" vector-effect="non-scaling-stroke"/>
              {Array.from({length: 17}, (_, i) =>
                <path d={`M${220 + i * 10} 333v${i === 8 ? -9 : i % 4 === 0 ? -5 : -2}`} vector-effect="non-scaling-stroke"/>
              )}
            </g>
          </svg>
        )}
      </div>
      <span class="pg-viewfinder-top" aria-hidden="true">A MODE · EV 0</span>
      <div class="pg-viewfinder-corners" aria-hidden="true"></div>
      <span class="pg-focus-mark" aria-hidden="true"></span>
    </div>
    <div class="pg-hud">
      <div><span>APERTURE</span><strong data-aperture-value>f/{initial.aperture}</strong></div>
      <div><span>SHUTTER</span><strong data-shutter-value>{initial.shutter}s</strong></div>
      <div><span>ISO</span><strong>100</strong></div>
      <div><span>景深</span><strong data-depth-value>{initial.depth}</strong></div>
    </div>
    <div class="pg-aperture-control">
      <label class="lab-sr-only" for="pg-aperture">调整光圈，观察散景虚化与快门联动</label>
      <div class="pg-aperture-rail">
        <input id="pg-aperture" type="range" min="0" max={lastStop} step="1" value={defaultStop}
          data-aperture-input aria-valuetext={apertureDescription(defaultStop)}/>
        <div class="pg-aperture-marks" aria-hidden="true">
          {apertureStops.map((_, i) => <span style={`left:${i / lastStop * 100}%`}/>)}
        </div>
      </div>
      <div class="pg-aperture-ticks" role="group" aria-label="直接选择光圈">
        {apertureStops.map(({aperture}, i) =>
          <button type="button" data-aperture-stop={i} aria-label={`光圈 f/${aperture}`} aria-pressed={i === defaultStop}>{aperture}</button>
        )}
      </div>
    </div>
  </div>
  <div class="pg-demo-guide">
    <p>拖动光圈刻度，观察散景虚化与快门联动</p>
    <a href="/lab/?guide=exposure" data-guide="exposure" data-demo-guide aria-haspopup="dialog" aria-controls="lab-reader">原理详见 GUIDE 04 <span aria-hidden="true">→</span></a>
  </div>
</div>
