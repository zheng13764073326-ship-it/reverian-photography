---
import EssayArrow from './EssayArrow.astro';
---
<div class="essay-progress" aria-hidden="true"><span data-reading-progress></span></div>
<nav class="essay-reader-nav" aria-label="随笔阅读导航" data-reader-nav><a href="/essays/" class="essay-return-link"><EssayArrow/><span>随笔</span></a><span>ESSAYS</span></nav>
<script>
 const nav=document.querySelector<HTMLElement>('[data-reader-nav]');
 const progress=document.querySelector<HTMLElement>('[data-reading-progress]');
 if(nav&&progress){
  let previous=window.scrollY,directionStart=previous,direction=0,frame=0,hasScrolledDown=false;
  const show=()=>{nav.classList.remove('is-hidden');nav.classList.toggle('is-returning',hasScrolledDown&&window.scrollY>=80);};
  const update=()=>{
   frame=0;
   const y=Math.max(0,window.scrollY),max=document.documentElement.scrollHeight-window.innerHeight;
   progress.style.transform=`scaleX(${max>0?Math.min(1,y/max):0})`;
   const nextDirection=Math.sign(y-previous);
   if(nextDirection&&nextDirection!==direction){directionStart=previous;direction=nextDirection;}
   if(y<80){hasScrolledDown=false;show();}
   else if(nav.contains(document.activeElement))show();
   else if(Math.abs(y-directionStart)>=10){
    if(direction>0){hasScrolledDown=true;nav.classList.add('is-hidden');nav.classList.remove('is-returning');}
    else show();
   }
   previous=y;
  };
  const schedule=()=>{if(!frame)frame=requestAnimationFrame(update);};
  addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);
  addEventListener('pageshow',()=>{previous=window.scrollY;directionStart=previous;direction=0;hasScrolledDown=false;show();schedule();});
  nav.addEventListener('focusin',show);
  new ResizeObserver(schedule).observe(document.body);
  update();
 }
</script>
