---
interface Props {direction?:'left'|'up'}
const {direction='left'}=Astro.props;
---
<svg class:list={['essay-arrow',{'essay-arrow-left':direction==='left'}]} width={direction==='left'?18:24} height={direction==='left'?18:24} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d={direction==='left'?'M20 12H4M11 5l-7 7 7 7':'M12 20V4M4 12l8-8 8 8'} stroke="currentColor" stroke-width={direction==='left'?'1.25':'1.8'} stroke-linecap="round" stroke-linejoin="round"/></svg>
