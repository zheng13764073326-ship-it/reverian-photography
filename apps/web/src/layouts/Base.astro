---
import PhotoOptics from '../components/PhotoOptics.astro';
import ExposureTransition from '../components/ExposureTransition.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import ImageLoading from '../components/ImageLoading.astro';
import ApertureIntro from '../components/ApertureIntro.astro';
import HoverFeedback from '../components/HoverFeedback.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import {getContent} from '../lib/content';
import {imageUrl} from '../lib/images';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '../styles/global.css';
import '../styles/press-feedback.css';
interface Props {title?:string;description?:string;home?:boolean;shareImage?:string;collection?:boolean;lab?:boolean}
const {settings,mode}=await getContent();
const {title,description=settings.seo.description,home=false,collection=false,lab=false}=Astro.props;
const siteTitle='挽风 | Reverian Photography';
const fullTitle=home?siteTitle:title?`${title} — ${siteTitle}`:siteTitle;
const canonical=new URL(Astro.url.pathname,Astro.site);
const shareImage=Astro.props.shareImage || (settings.seo.shareImage?imageUrl(settings.seo.shareImage.photo,1200):undefined);
---
<!doctype html><html lang="zh-CN"><head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{fullTitle}</title><meta name="description" content={description}/><meta name="theme-color" content={collection||lab?'#F4F3EE':'#F4F1E9'}/>
 <link rel="canonical" href={canonical}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
 {shareImage && <meta property="og:image" content={new URL(shareImage,Astro.site)}/>}
 {mode==='demo' && <meta name="robots" content="noindex, nofollow"/>}
 <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
 {home && <link rel="preload" href="/images/branding/wanfeng-white.webp" as="image"/>}
 <ExposureTransition/>
 </head><body id="top" class:list={[{'is-home':home,'is-collection':collection,'is-lab':lab}]}>
 {home && <ApertureIntro name={settings.photographer}/>}
 <a class="skip-link" href="#main">跳到正文</a><Header home={home}/>
 <main id="main" tabindex="-1"><slot/></main>
 <Footer demo={mode==='demo'}/>
 <PhotoOptics/><Lightbox/><ImageLoading/><HoverFeedback/><ScrollReveal/>
 </body></html>
