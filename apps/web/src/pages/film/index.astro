---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FilmFrame from '../../components/film/FilmFrame.astro';
import DriftCard from '../../components/film/DriftCard.astro';
import {getContent} from '../../lib/content';
const {photos}=await getContent();
const frames=photos.filter(photo=>photo.sections.includes('film'));
---
<Base title="胶片来信" description="用一次性胶片相机留下日常，让照片与短文成为一封封慢慢显影的来信。">
 <div class="container page film-page">
  <SectionHeading title="胶片来信" english="SILVER HALIDE" href="/film/spring-drift-2026/" label="进入暗房" page/>
  <div class="film-introduction"><p>脱离数码屏幕的即时预览，把决定权交给塑料镜头、过片齿轮与未知的时间。</p></div>
  <DriftCard/>{frames.length>0&&<div class="film-sequence">{frames.map((photo,index)=><FilmFrame photo={photo} index={index}/>)}</div>}
 </div>
</Base>
<style>
 .film-page :global(.eyebrow){letter-spacing:.15em;color:#8c8881}.film-page :global(h1){color:#1c1c1a}
 .film-introduction{max-width:760px;margin-bottom:64px;font:18px/2.1 var(--serif-zh);color:var(--muted)}
 .film-introduction p{margin:0 0 1em}.film-introduction p:first-child{color:var(--ink)}
 .film-sequence{display:grid;gap:88px;margin-top:80px}
 @media(max-width:600px){.film-introduction{font-size:17px;margin-bottom:42px}.film-sequence{gap:60px}}
</style>
