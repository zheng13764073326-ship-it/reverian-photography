---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import {getContent} from '../../lib/content';
const {albums}=await getContent();
---
<Base title="光影存档"><div class="container page"><SectionHeading title="光影存档" english="PHOTO ARCHIVE" page/><div class="album-grid">{albums.map(album=><AlbumCard album={album}/>)}</div>{!albums.length&&<p>光影存档正在整理中。</p>}</div></Base>
