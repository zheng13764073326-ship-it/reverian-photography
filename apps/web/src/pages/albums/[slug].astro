---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import RichText from '../../components/RichText.astro';
import {getContent} from '../../lib/content';
import {imageUrl} from '../../lib/images';
export async function getStaticPaths(){const {albums}=await getContent();return albums.map((album,i)=>({params:{slug:album.slug},props:{album,previous:albums[i-1],next:albums[i+1]}}));}
const {album,previous,next}=Astro.props;
// The cover opens the viewing sequence; avoid showing it again in the body.
const spreads=album.spreads.map(s=>({...s,photos:s.photos.filter(p=>p.id!==album.cover.photo.id)})).filter(s=>s.photos.length);
const photoCount=new Set([album.cover.photo.id,...spreads.flatMap(s=>s.photos.map(p=>p.id))]).size;
const related=next || previous;
const titleParts=album.title.split(/\s*·\s*/);
const splitTitle=titleParts.length===2 && titleParts[0]===album.city;
---
<Base title={album.title} description={album.excerpt} shareImage={imageUrl(album.cover.photo,1200)}>
 <article class="container page album-detail">
  <header class="album-opening">
   <div class="album-topline"><a href="/albums/">← 光影存档</a><span>REVERIAN / PHOTO ARCHIVE</span></div>
   <div class="album-heading">
    <h1>{splitTitle?<><span class="album-city">{titleParts[0]}</span><span class="album-subtitle">{titleParts[1]}</span></>:album.title}</h1>
    <div class="album-edition"><p>{album.country} / {album.city}</p><p>{album.date.slice(0,7).replace('-','.')} <span>·</span> {photoCount} 张作品</p></div>
   </div>
  </header>
  <div class="album-cover">
   <Photo photo={album.cover.photo} group="album" caption={false} showInfo={false} lightboxCaption={album.cover.photo.caption} eager sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 80px), 1200px"/>
   <div class="album-cover-note"><span class="album-cover-credit"><span>摄影 / Reverian</span>{album.cover.photo.caption&&<span class="cover-location">{album.cover.photo.caption}</span>}</span><a href="#album-sequence">展开这段旅程 ↓</a><span>点击照片，放大观看</span></div>
  </div>
  <section class="album-preface" aria-label="影集序言">
   <p class="eyebrow">A NOTE BEFORE THE JOURNEY</p>
   <RichText value={album.preface}/>
  </section>
  <div class="spreads" id="album-sequence">
   {spreads.map((spread,i)=><section class:list={['spread',`spread-${spread.layout}`,{'spread-reverse':spread.layout==='text'&&i>0,'spread-quiet':spread.layout==='text'&&!spread.text.length,'spread-portrait':spread.photos.length===1&&spread.photos[0].image.height>spread.photos[0].image.width,'spread-single':spread.photos.length===1&&spread.layout==='pair'}]}>
    {spread.photos.map(p=><Photo photo={p} group="album" caption={false} showInfo={false} lightboxCaption={p.caption} sizes={spread.layout==='full'?'(max-width: 600px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 80px), 1200px':undefined}/>)}
    {spread.layout==='text'&&spread.text.length>0&&<RichText value={spread.text}/>}</section>)}
  </div>
  <div class="album-colophon"><p class="eyebrow">END OF THIS JOURNEY</p><span>{photoCount} 张作品 / REVERIAN</span></div>
  <nav class="album-next" aria-label="继续浏览影集">
   {related?<a class="next-story" href={`/albums/${related.slug}/`}>
    <Photo photo={related.cover.photo} cover={related.cover} ratio={3/2} lightbox={false} caption={false} sizes="(max-width: 600px) calc(100vw - 40px), 360px"/>
    <div><p class="eyebrow">{next?'NEXT JOURNEY':'ANOTHER JOURNEY'}</p><h2>{related.title}</h2><p>{related.excerpt}</p><span>继续翻阅 →</span></div>
   </a>:<a class="return-stories" href="/albums/"><span class="eyebrow">PHOTO ARCHIVE</span><span>回到光影存档 <span aria-hidden="true">↗</span></span></a>}
  </nav>
 </article>
</Base>
<style>
 .album-detail{padding-top:calc(var(--header) + 28px)}
 .album-topline,.album-edition,.album-cover-note,.album-colophon>span{font-size:11px;color:var(--muted)}
 .album-topline{display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:16px;letter-spacing:.08em;margin-bottom:28px}
 .album-topline a{padding-block:8px}
 .album-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:34px}
 .album-heading h1{margin:0;font-size:clamp(36px,4.2vw,62px);letter-spacing:.04em}
 .album-city{display:block;font-size:clamp(54px,6vw,86px);line-height:1.1;letter-spacing:.16em}
 .album-subtitle{display:block;font-family:var(--serif-zh);font-variant-numeric:lining-nums;font-size:clamp(22px,2.1vw,30px);margin-top:14px;letter-spacing:.16em}
 .album-edition{text-align:right;letter-spacing:.1em;flex-shrink:0}
 .album-edition p{margin:4px 0}.album-edition span{padding:0 8px}
 .album-cover-note{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);letter-spacing:.08em}
 .album-cover-credit{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px 12px}.cover-location{border-left:1px solid var(--line);padding-left:12px}
 .album-preface{max-width:720px;margin:80px auto 100px}
 .album-excerpt-lead{font-family:var(--serif);font-size:26px;line-height:1.85;max-width:320px;margin:0}
 .album-preface :global(.prose){font-size:14px;color:var(--muted)}
 .album-detail :global(.spreads){gap:48px}
 .album-detail :global(.spread-text .prose){padding:0 clamp(16px,4vw,64px);color:var(--muted);font-size:14px;line-height:2.2}
 .album-detail :global(.spread-text h2){font-size:32px;color:var(--ink);margin:0 0 30px}
 .album-detail :global(.spread-text .photograph){width:100%;max-width:510px}
 .album-detail :global(.spread-reverse .photograph){grid-column:2;grid-row:1;justify-self:end}
 .album-detail :global(.spread-reverse .prose){grid-column:1;grid-row:1}
 .album-detail :global(.spread-single){grid-template-columns:1fr;max-width:800px;margin-inline:auto}
 .album-detail :global(.spread-quiet){display:flex;justify-content:flex-start}
 .album-detail :global(.spread-quiet.spread-reverse){justify-content:flex-end}
 .album-detail :global(.spread-quiet .photograph){width:64%;max-width:760px}
 .album-detail :global(.spread-quiet.spread-portrait .photograph){max-width:510px}
 .album-colophon{text-align:center;margin:96px auto 80px}
 .album-colophon p{margin:20px 0}
 .album-next{border-top:1px solid var(--line);padding-top:36px}
 .next-story{display:grid;grid-template-columns:360px 1fr;gap:60px;align-items:center}
 .next-story h2{font-family:var(--serif-zh);font-variant-numeric:lining-nums;font-size:32px;margin-bottom:12px}.next-story p:not(.eyebrow){color:var(--muted);font-size:13px}.next-story span{font-size:13px}
 .return-stories{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px 0}.return-stories>span:last-child{font-family:var(--serif);font-size:26px}
 @media(max-width:800px){.album-preface{gap:36px;margin-block:64px}.next-story{grid-template-columns:1fr 1fr;gap:30px}.album-detail :global(.spread-text .prose){padding-inline:12px}}
 @media(max-width:600px){
  .album-detail{padding-top:calc(var(--header) + 24px)}.album-topline{font-size:14px;letter-spacing:0;margin-bottom:22px;gap:12px}.album-topline>span{font-size:11px;letter-spacing:.02em;text-align:right}
  .album-heading{display:block;margin-bottom:26px}.album-subtitle{font-size:22px;letter-spacing:.08em;margin-top:12px}.album-edition{text-align:left;display:flex;flex-wrap:wrap;gap:6px 20px;font-size:10px;margin-top:24px}
  .album-cover-note{font-size:9px;gap:8px;letter-spacing:0;flex-wrap:wrap}.album-cover-note>span:last-child{display:none}
  .album-preface{grid-template-columns:1fr;gap:24px;margin:48px 0 60px}.album-excerpt-lead{font-size:23px;max-width:none}.album-preface :global(.prose){font-size:14px}
  .album-detail :global(.spreads){gap:28px}.album-detail :global(.spread){gap:20px}.album-detail :global(.spread-text .prose){padding:12px 6px 0}.album-detail :global(.spread-text h2){font-size:27px;margin-bottom:20px}
  .album-detail :global(.spread-text .photograph){max-width:none}.album-detail :global(.spread-text .photograph img){max-height:none}
  .album-detail :global(.spread-quiet .photograph){width:100%;max-width:none}
  .album-colophon{margin:64px auto 48px}.next-story{grid-template-columns:1fr;gap:24px}.next-story h2{font-size:28px}.return-stories>span:last-child{font-size:22px}.return-stories .eyebrow{font-size:9px}
 }
</style>
