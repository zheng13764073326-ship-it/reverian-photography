---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Photo from '../../components/Photo.astro';
import {getContent} from '../../lib/content';
import {pageItems} from '../../lib/publishing';
export async function getStaticPaths(){
 const {photos}=await getContent();
 return [{section:'works',title:'精选作品',english:'SELECTED PHOTOGRAPHS',items:photos.filter(p=>p.featured)},{section:'street',title:'街巷观察',english:'STREET OBSERVATIONS',items:photos.filter(p=>p.sections.includes('street'))}].flatMap(({items,...section})=>{
  const pages=pageItems(items,24);return pages.map((photos,i)=>({params:{section:section.section,page:i?String(i+1):undefined},props:{...section,photos,current:i+1,total:pages.length}}));
 });
}
const {section,title,english,photos,current,total}=Astro.props;
const link=(n:number)=>`/${section}/${n===1?'':`${n}/`}`;
---
<Base title={`${title}${current>1?` · ${current}`:''}`}><div class="container page"><SectionHeading title={title} english={english} page/><div class="photo-grid">{photos.map((p,i)=><Photo photo={p} eager={i<2} group="listing"/>)}</div>{!photos.length&&<p>作品正在整理中。</p>}{total>1&&<nav class="pagination" aria-label="作品分页">{current>1&&<a href={link(current-1)}>← 上一页</a>}<span>{current} / {total}</span>{current<total&&<a href={link(current+1)}>下一页 →</a>}</nav>}</div></Base>
