---
import Base from '../layouts/Base.astro';
import guides from '../data/lab/guides.json';
import prompts from '../data/lab/prompts.json';
import SunsetObservatory from '../components/SunsetObservatory.astro';
import introductions from '../data/lab/introductions.json';
import '@fontsource-variable/noto-serif-sc/wght.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/lab.css';
const uses=[['all','全部'],...prompts.map(prompt=>[prompt.category,prompt.title])];
---
<Base title="摄影入门" description={introductions.guides} lab>
  <div class="lab-page container" data-optical-lab>
    <header class="lab-heading">
      <p class="lab-eyebrow">OPTICAL LAB <span>// 01</span></p>
      <h1 data-lab-title>摄影入门</h1>
      <p class="lab-subtitle" data-lab-subtitle>{introductions.guides}</p>
    </header>
    <section id="lab-panel-guides" class="lab-panel" aria-labelledby="lab-section-guides" data-lab-panel="guides">
      <div class="lab-section-line"><h2 id="lab-section-guides">入门指南</h2><p>FIELD NOTES <span>/ 04 GUIDES</span></p></div>
      <div class="lab-guide-grid">
        {guides.map(guide=><button type="button" class="lab-guide-card lab-corners" data-guide={guide.id} aria-haspopup="dialog" aria-controls="lab-reader">
          <span class="lab-card-index">GUIDE {guide.index}<span>{guide.tag}</span></span>
          <strong>{guide.title}</strong><span class="lab-guide-summary">{guide.summary}</span>
          <span class="lab-card-bottom"><span>大纲 · 预计 {guide.readTime}</span><span aria-hidden="true">↗</span></span>
        </button>)}
      </div>
      {guides.map(guide=><template data-guide-template={guide.id} data-title={guide.title} data-index={guide.index} data-tag={guide.tag}>
        <p class="lab-reader-intro">{guide.summary}</p><p class="lab-outline-label">指南大纲 · 内容与实拍对照持续补充</p>
        {guide.content.map(section=><section><h3>{section.heading}</h3><ul>{section.points.map(point=><li>{point}</li>)}</ul></section>)}
      </template>)}
    </section>

    <section id="lab-panel-ai" class="lab-panel" aria-labelledby="lab-section-ai" data-lab-panel="ai" hidden>
      <div class="lab-section-line"><h2 id="lab-section-ai">提示词档案</h2><p>PROMPT ARCHIVE <span>/ 06 PRESETS</span></p></div>
      <div class="lab-use-filters" role="group" aria-label="提示词用途筛选">{uses.map(([id,label])=><button type="button" data-prompt-filter={id} aria-pressed={id==='all'?'true':'false'} aria-controls="lab-prompt-grid">{label}</button>)}</div>
      <p class="lab-prompt-intro">保留照片本来的故事，让调整有明确的方向。复制后，连同原片交给你使用的 AI 修图工具。</p>
      <output class="lab-sr-only" data-prompt-count aria-live="polite">6 条提示词</output>
      <div class="lab-prompt-grid" id="lab-prompt-grid">
        {prompts.map(prompt=><article class="lab-prompt-card" data-prompt-category={prompt.category}>
          <header><h3>PROMPT {prompt.index} <span>// {prompt.title}</span></h3><span>{prompt.style}</span></header>
          <div class="lab-prompt-image">
            {prompt.src?<img src={prompt.src} alt={`${prompt.title}样片`} width="1600" height="900" loading="lazy" decoding="async"/>:<span aria-label="未曝光样片占位">FRAME {prompt.index}<small>// 16:9 · PENDING</small></span>}
          </div>
          <pre tabindex="0" aria-label={`${prompt.title}提示词`}><code lang="en">{prompt.prompt}</code></pre>
          <footer><span class="lab-copy-status" role="status" aria-live="polite"></span><button type="button" class="lab-copy" data-copy-prompt aria-label={`复制${prompt.title}提示词`}><i aria-hidden="true" hidden></i><span>复制提示词</span></button></footer>
        </article>)}
      </div>
    </section>

    <section id="lab-panel-sunset" class="lab-panel" aria-labelledby="lab-section-sunset" data-lab-panel="sunset" hidden>
      <SunsetObservatory/>
    </section>
    <noscript><p class="lab-noscript">请开启 JavaScript，以使用栏目导航、阅读指南和获取天气数据。</p></noscript>
    <dialog id="lab-reader" class="lab-reader" aria-labelledby="lab-reader-title">
      <header><span data-reader-index>GUIDE</span><button type="button" data-reader-close autofocus aria-label="关闭指南">关闭 ×</button></header>
      <div class="lab-reader-scroll" tabindex="0"><p class="lab-eyebrow" data-reader-tag></p><h2 id="lab-reader-title"></h2><div data-reader-body></div></div>
      <footer>REVERIAN // OPTICAL LAB</footer>
    </dialog>
  </div>
</Base>
<script>
  import {setupOpticalLab} from '../lib/optical-lab';
  const root=document.querySelector<HTMLElement>('[data-optical-lab]');
  if(root)setupOpticalLab(root);
</script>
